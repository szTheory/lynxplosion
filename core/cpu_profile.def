OP(0x1B, NOP, NOP1, F_NO_POLL, RUN)
OP(0x1C, TRB, ABS_RMW, 0, RUN)
OP(0x1D, ORA, ABX_R, 0, RUN)
OP(0x1E, ASL, ABX_RMW, 0, TIER_STATE)
OPX(0x1F, NOP, NOP_ABS4, F_BITOP_SLOT | F_UNV_SHAPE, TIER_STATE, BBR, ZPREL, F_BITOP_SLOT, RUN)
