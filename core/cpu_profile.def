/* Profile data: one row per opcode, the single source of both profile tables.
   Included only by cpu_profile.c, which defines the OP and OPX macros.

     OP(opcode, KIND, MODE, FLAGS, VEC)                     row shared by both profiles
     OPX(opcode, K1, M1, F1, V1, K2, M2, F2, V2)            row that differs: the lynx1 half,
                                                            then the lynx2 half

   KIND, MODE and VEC are the suffixes of the LYNX__K_, LYNX__M_ and LYNX__V_
   enums; FLAGS is 0 or an OR of the F_ names. Exactly 32 rows are OPX: the
   opcodes ending in 7 or F. lynx1 follows the 65SC02 shapes taken from the
   synertek vectors, lynx2 the Rockwell R65C02 bit operations. Bit numbers for
   RMB, SMB, BBR and BBS come from opcode bits 4 to 6. Under profile none an
   opcode is defined only when its two rows are identical.

   Every cycle count and behaviour here is a stand-in from another vendor's
   datasheet, a hardware-informed test or a software model, never a Lynx fact.
   Two bytes (CB and DB) are 1-byte no-poll NOPs because of a hardware-informed
   test; the model vectors for them are excluded by the V_EXCL_HW policy. */
OP(0x00, BRK, BRK, 0, RUN)
OP(0x01, ORA, IZX_R, 0, RUN)
OP(0x02, NOP, IMM, 0, RUN)
OP(0x03, NOP, NOP1, F_NO_POLL, RUN)
OP(0x04, TSB, ZP_RMW, 0, RUN)
OP(0x05, ORA, ZP_R, 0, RUN)
OP(0x06, ASL, ZP_RMW, 0, RUN)
OPX(0x07, NOP, ZP_R, F_BITOP_SLOT | F_UNV_SHAPE, TIER_STATE, RMB, ZP_RMW, F_BITOP_SLOT, RUN)
OP(0x08, PHP, PUSH, 0, RUN)
OP(0x09, ORA, IMM, 0, RUN)
OP(0x0A, ASLA, IMPL, 0, RUN)
OP(0x0B, NOP, NOP1, F_NO_POLL, RUN)
OP(0x0C, TSB, ABS_RMW, 0, RUN)
OP(0x0D, ORA, ABS_R, 0, RUN)
OP(0x0E, ASL, ABS_RMW, 0, RUN)
OPX(0x0F, NOP, NOP_ABS3, F_BITOP_SLOT | F_UNV_SHAPE, TIER_STATE, BBR, ZPREL, F_BITOP_SLOT, RUN)
OP(0x10, BPL, REL, 0, RUN)
OP(0x11, ORA, IZY_R, 0, RUN)
OP(0x12, ORA, IZP_R, 0, RUN)
