  endif()

  file(REMOVE "${alias_timeline}")
  file(WRITE "${WORK}/input.timeline" "LYNX-INPUT 1\n109321 16\n")
  foreach(kind schema timeline file-offset sample-ordinal prefix)
    run_expected_refusal("LYNX_TEST_AV_BAD_CHECKPOINT=${kind}"
