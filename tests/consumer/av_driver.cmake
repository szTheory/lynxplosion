cmake_path(GET WORK PARENT_PATH work_parent)
cmake_path(GET WORK FILENAME work_name)
if(NOT scratch_normal STREQUAL expected_scratch OR NOT scratch_real STREQUAL expected_scratch OR
   NOT work_parent STREQUAL scratch_normal OR NOT work_name STREQUAL CASE)
  message(FATAL_ERROR "av_driver: refusing scratch outside its owned check directory: ${WORK}")
endif()
