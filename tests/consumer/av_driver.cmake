string(REGEX REPLACE "\nav_guest_bytes = [^\n]*" "" malformed_av_manifest "${malformed_av_manifest}")
file(WRITE "${manifest_control}/fixtures/manifests/av-probe.manifest" "${malformed_av_manifest}")
execute_process(COMMAND sh "${ROOT}/scripts/check-manifests.sh" --root "${manifest_control}"
  TIMEOUT 30 RESULT_VARIABLE manifest_rc OUTPUT_VARIABLE manifest_out ERROR_VARIABLE manifest_err)
if(manifest_rc STREQUAL "0" OR
   NOT "${manifest_out}${manifest_err}" MATCHES "incomplete A/V provenance group: missing key: av_guest_bytes" OR
   "${manifest_out}${manifest_err}" MATCHES "incomplete input-probe provenance group")
  message(FATAL_ERROR "av_driver: malformed A/V provenance control failed unexpectedly (${manifest_rc})\n${manifest_out}${manifest_err}")
endif()
file(REMOVE_RECURSE "${manifest_control}")
file(MAKE_DIRECTORY "${SCRATCH_ROOT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(WORK "${WORK}-${nonce}")
execute_process(COMMAND "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin" mkdir "${WORK}"
  RESULT_VARIABLE mkdir_rc OUTPUT_VARIABLE mkdir_out ERROR_VARIABLE mkdir_err)
if(NOT mkdir_rc STREQUAL "0")
  message(FATAL_ERROR "av_driver: exclusive scratch creation failed: ${mkdir_out}${mkdir_err}")
endif()
execute_process(COMMAND "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin"
    "CC65_HOME=${ROOT}/build/pins/cc65" "${CA65}" --cpu 65SC02
    -o "${WORK}/av_probe.o" "${SOURCE}"
  WORKING_DIRECTORY "${WORK}" TIMEOUT 30 RESULT_VARIABLE ca_rc
  OUTPUT_VARIABLE ca_out ERROR_VARIABLE ca_err)
if(NOT ca_rc STREQUAL "0")
  message(FATAL_ERROR "av_driver: pinned ca65 failed to assemble av_probe.s\n${ca_out}${ca_err}")
endif()
execute_process(COMMAND "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin"
    "CC65_HOME=${ROOT}/build/pins/cc65" "${LD65}" -C "${CONFIG}"
    -Ln "${WORK}/av_probe.lbl" -o "${WORK}/av_probe.bll" "${WORK}/av_probe.o"
  WORKING_DIRECTORY "${WORK}" TIMEOUT 30 RESULT_VARIABLE ld_rc
  OUTPUT_VARIABLE ld_out ERROR_VARIABLE ld_err)
if(NOT ld_rc STREQUAL "0" OR NOT EXISTS "${WORK}/av_probe.bll" OR NOT EXISTS "${WORK}/av_probe.lbl")
  message(FATAL_ERROR "av_driver: pinned ld65 failed to link av_probe\n${ld_out}${ld_err}")
endif()
file(SHA256 "${WORK}/av_probe.bll" guest_sha)
file(SIZE "${WORK}/av_probe.bll" guest_size)
file(STRINGS "${MANIFEST}" manifest_guest REGEX "^av_guest_sha256 = ")
file(STRINGS "${MANIFEST}" manifest_guest_size REGEX "^av_guest_bytes = ")
if(NOT manifest_guest STREQUAL "av_guest_sha256 = ${guest_sha}" OR
   NOT manifest_guest_size STREQUAL "av_guest_bytes = ${guest_size}")
  message(FATAL_ERROR "av_driver: source-built BLL bytes differ from the project fixture manifest")
endif()
function(run_replay binary output control)
  set(input_timeline "${WORK}/input.timeline")
  if(ARGC GREATER 3)
    set(input_timeline "${ARGV3}")
  endif()
  set(command "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin")
  if(NOT "${control}" STREQUAL "")
    list(APPEND command "${control}")
  endif()
  list(APPEND command "${binary}" --mode av-replay --content "${WORK}/av_probe.bll"
    --symbols "${WORK}/av_probe.lbl" --timeline "${input_timeline}"
    --out "${output}" --profile none)
  execute_process(COMMAND ${command} TIMEOUT 120 RESULT_VARIABLE run_rc
    OUTPUT_VARIABLE run_out ERROR_VARIABLE run_err)
  if(NOT "${run_rc}" STREQUAL "0")
    message(FATAL_ERROR "${CASE}: replay failed (${run_rc})\n${run_out}${run_err}\nArtifacts retained under ${output}")
  endif()
endfunction()

function(run_expected_refusal control expected output)
  set(input_timeline "${WORK}/input.timeline")
  if(ARGC GREATER 3)
    set(input_timeline "${ARGV3}")
  endif()
  set(command "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin")
  if(NOT "${control}" STREQUAL "")
    list(APPEND command "${control}")
  endif()
  list(APPEND command "${TEST_CONSUMER}" --mode av-replay --content "${WORK}/av_probe.bll"
    --symbols "${WORK}/av_probe.lbl" --timeline "${input_timeline}"
    --out "${output}" --profile none)
  execute_process(COMMAND ${command} TIMEOUT 120 RESULT_VARIABLE run_rc
    OUTPUT_VARIABLE run_out ERROR_VARIABLE run_err)
  if("${run_rc}" STREQUAL "0" OR NOT "${run_out}${run_err}" MATCHES "${expected}")
    message(FATAL_ERROR "${CASE}: refusal control '${control}' did not fail at its named assertion (${run_rc})\n${run_out}${run_err}")
  endif()
  if(EXISTS "${output}")
    message(FATAL_ERROR "${CASE}: refusal control '${control}' published output before rejecting the checkpoint")
  endif()
endfunction()

function(compare_bundles left right)
  foreach(name input.timeline input.applied guest.progress audio.pcm audio.wav audio.events av.manifest
      released.raw released.ppm pressed.raw pressed.ppm frames.raw frames.ppm)
    if(NOT EXISTS "${left}/${name}" OR NOT EXISTS "${right}/${name}")
      message(FATAL_ERROR "${CASE}: complete replay bundle is missing ${name}")
    endif()
    file(SIZE "${left}/${name}" left_size)
    file(SIZE "${right}/${name}" right_size)
    file(SHA256 "${left}/${name}" left_hash)
    file(SHA256 "${right}/${name}" right_hash)
    if(NOT left_size EQUAL right_size OR NOT left_hash STREQUAL right_hash)
      message(FATAL_ERROR "${CASE}: restored and control replay differ in ${name}")
    endif()
  endforeach()
endfunction()

function(check_stream_identity directory filename size_key sha_key)
  file(SIZE "${directory}/${filename}" actual_size)
  file(SHA256 "${directory}/${filename}" actual_sha)
  file(STRINGS "${directory}/av.manifest" manifest_size REGEX "^${size_key} = ")
  file(STRINGS "${directory}/av.manifest" manifest_sha REGEX "^${sha_key} = ")
  list(LENGTH manifest_size size_count)
  list(LENGTH manifest_sha sha_count)
  if(NOT size_count EQUAL 1 OR NOT sha_count EQUAL 1 OR
     NOT manifest_size STREQUAL "${size_key} = ${actual_size}" OR
     NOT manifest_sha STREQUAL "${sha_key} = ${actual_sha}")
    message(FATAL_ERROR "${CASE}: av.manifest does not bind ${filename} to its exact extent and bytes")
  endif()
endfunction()

function(check_replay_bundle directory timeline_sha)
  file(STRINGS "${directory}/av.manifest" content_identity REGEX "^content_sha256 = ")
  file(STRINGS "${directory}/av.manifest" input_identity REGEX "^input_sha256 = ")
  file(STRINGS "${directory}/av.manifest" timeline_identity REGEX "^timeline_sha256 = ")
  file(STRINGS "${directory}/av.manifest" timeline_stream_identity REGEX "^timeline_stream_sha256 = ")
  if(NOT content_identity STREQUAL "content_sha256 = ${guest_sha}" OR
     NOT input_identity STREQUAL "input_sha256 = ${timeline_sha}" OR
     NOT timeline_identity STREQUAL "timeline_sha256 = ${timeline_sha}" OR
     NOT timeline_stream_identity STREQUAL "timeline_stream_sha256 = ${timeline_sha}")
    message(FATAL_ERROR "${CASE}: manifest content/timeline identity does not match the source-built guest and canonical input")
  endif()
  check_stream_identity("${directory}" input.timeline input_bytes input_sha256)
  check_stream_identity("${directory}" input.applied input_applied_bytes input_applied_sha256)
  check_stream_identity("${directory}" guest.progress guest_progress_bytes guest_progress_sha256)
  check_stream_identity("${directory}" frames.raw frames_raw_bytes frames_raw_sha256)
  check_stream_identity("${directory}" frames.ppm frames_ppm_bytes frames_ppm_sha256)
  check_stream_identity("${directory}" released.raw released_raw_bytes released_raw_sha256)
  check_stream_identity("${directory}" released.ppm released_ppm_bytes released_ppm_sha256)
  check_stream_identity("${directory}" pressed.raw pressed_raw_bytes pressed_raw_sha256)
  check_stream_identity("${directory}" pressed.ppm pressed_ppm_bytes pressed_ppm_sha256)
  check_stream_identity("${directory}" audio.pcm pcm_bytes pcm_sha256)
  check_stream_identity("${directory}" audio.wav wav_bytes wav_sha256)
  check_stream_identity("${directory}" audio.events events_bytes events_sha256)
  execute_process(COMMAND "${ARTIFACT_CHECKER}" av-replay "${directory}" "${guest_sha}" "${timeline_sha}"
    TIMEOUT 30 RESULT_VARIABLE checker_rc OUTPUT_VARIABLE checker_out ERROR_VARIABLE checker_err)
  if(NOT checker_rc STREQUAL "0")
    message(FATAL_ERROR "${CASE}: independent full-stream checker failed (${checker_rc})\n${checker_out}${checker_err}\nArtifacts retained under ${directory}")
  endif()
endfunction()

function(expect_replay_rejection directory expected)
  execute_process(COMMAND "${ARTIFACT_CHECKER}" av-replay "${directory}" "${guest_sha}" "${timeline_sha}"
    TIMEOUT 30 RESULT_VARIABLE checker_rc OUTPUT_VARIABLE checker_out ERROR_VARIABLE checker_err)
  if(checker_rc STREQUAL "0" OR NOT "${checker_out}${checker_err}" MATCHES "${expected}")
    message(FATAL_ERROR "${CASE}: mutation was not rejected at '${expected}' (${checker_rc})\n${checker_out}${checker_err}")
  endif()
endfunction()

function(replace_text_file path before after)
  file(READ "${path}" original)
  string(FIND "${original}" "${before}" position)
  if(position LESS 0)
    message(FATAL_ERROR "${CASE}: mutation source text is absent from ${path}")
  endif()
  string(REPLACE "${before}" "${after}" updated "${original}")
  if(updated STREQUAL original)
    message(FATAL_ERROR "${CASE}: requested mutation made no change to ${path}")
  endif()
  file(WRITE "${path}" "${updated}")
endfunction()

if(CASE STREQUAL "consumer.av_tracer")
  file(WRITE "${WORK}/input.timeline" "LYNX-INPUT 1\n109321 16\n")
  file(SHA256 "${WORK}/input.timeline" input_sha)
  set(output "${WORK}/output")
  run_replay("${CONSUMER}" "${output}" "")
  execute_process(COMMAND "${ARTIFACT_CHECKER}" av "${output}"
    TIMEOUT 30 RESULT_VARIABLE checker_rc OUTPUT_VARIABLE checker_out ERROR_VARIABLE checker_err)
  if(NOT checker_rc STREQUAL "0")
    message(FATAL_ERROR "av_driver: independent A/V checker failed (${checker_rc})\n${checker_out}${checker_err}\nArtifacts retained under ${output}")
  endif()
  file(STRINGS "${output}/av.manifest" manifest_content REGEX "^content_sha256 = ")
  file(STRINGS "${output}/av.manifest" manifest_input REGEX "^input_sha256 = ")
  file(STRINGS "${output}/av.manifest" manifest_schema REGEX "^schema_version = ")
  file(STRINGS "${output}/av.manifest" manifest_applied_count REGEX "^input_applied_count = ")
  if(NOT manifest_schema STREQUAL "schema_version = 1" OR
     NOT manifest_applied_count STREQUAL "input_applied_count = 1" OR
     NOT manifest_content STREQUAL "content_sha256 = ${guest_sha}" OR
     NOT manifest_input STREQUAL "input_sha256 = ${input_sha}")
    message(FATAL_ERROR "av_driver: A/V manifest does not bind the exact guest and canonical input bytes")
  endif()
  file(READ "${output}/input.applied" applied_records)
  if(NOT applied_records STREQUAL "LYNX-APPLIED-INPUT 1\n0 13 109321 0 16\n")
    message(FATAL_ERROR "av_driver: applied-input transcript does not match the successful public input call")
  endif()
  file(STRINGS "${output}/guest.progress" progress_lines)
  list(LENGTH progress_lines progress_line_count)
  math(EXPR progress_record_count "${progress_line_count} - 1")
  file(STRINGS "${output}/av.manifest" manifest_progress_count REGEX "^guest_progress_count = ")
  if(progress_line_count LESS 2 OR NOT manifest_progress_count STREQUAL "guest_progress_count = ${progress_record_count}")
    message(FATAL_ERROR "av_driver: guest progress stream does not contain every captured frame record")
  endif()
  foreach(stream input.applied guest.progress)
    if(stream STREQUAL "input.applied")
      set(key input_applied)
    else()
      set(key guest_progress)
    endif()
    file(SIZE "${output}/${stream}" actual_size)
    file(SHA256 "${output}/${stream}" actual_sha)
    file(STRINGS "${output}/av.manifest" manifest_size REGEX "^${key}_bytes = ")
    file(STRINGS "${output}/av.manifest" manifest_hash REGEX "^${key}_sha256 = ")
    if(NOT manifest_size STREQUAL "${key}_bytes = ${actual_size}" OR
       NOT manifest_hash STREQUAL "${key}_sha256 = ${actual_sha}")
      message(FATAL_ERROR "av_driver: manifest does not bind ${stream} extent and exact bytes")
    endif()
  endforeach()
  foreach(name released.raw released.ppm pressed.raw pressed.ppm audio.pcm audio.wav audio.events)
    file(SHA256 "${output}/${name}" actual_sha)
    string(REPLACE "." "_" key "${name}")
    if(name STREQUAL "audio.pcm")
      set(key "pcm")
    elseif(name STREQUAL "audio.wav")
      set(key "wav")
    elseif(name STREQUAL "audio.events")
      set(key "events")
    endif()
    file(STRINGS "${output}/av.manifest" manifest_hash REGEX "^${key}_sha256 = ")
    if(NOT manifest_hash STREQUAL "${key}_sha256 = ${actual_sha}")
      message(FATAL_ERROR "av_driver: A/V manifest hash differs for ${name}")
    endif()
  endforeach()
  message(STATUS "consumer.av_tracer: source-built ${guest_size}-byte guest produced released/pressed video plus non-silent 40000Hz stereo S16 spans")
elseif(CASE STREQUAL "consumer.av_edges")
  file(WRITE "${WORK}/input.timeline"
    "LYNX-INPUT 1\n0 16\n109321 0\n162815 16\n162816 0\n162817 16\n163199 0\n163200 16\n163201 0\n")
  file(WRITE "${WORK}/watch.timeline" "LYNX-INPUT 1\n109321 16\n")
  set(restored "${WORK}/output-restored")
  set(short "${WORK}/output-short-spans")
  set(uninterrupted "${WORK}/output-uninterrupted")
  set(watch_baseline "${WORK}/output-watch-baseline")
  set(watch_resumed "${WORK}/output-watch-resumed")
  run_replay("${CONSUMER}" "${restored}" "")
  run_replay("${TEST_CONSUMER}" "${short}" "LYNX_TEST_AV_SHORT_SPANS=1")
  run_replay("${TEST_CONSUMER}" "${uninterrupted}" "LYNX_TEST_AV_UNINTERRUPTED=1")
  compare_bundles("${restored}" "${short}")
  compare_bundles("${restored}" "${uninterrupted}")
  run_replay("${CONSUMER}" "${watch_baseline}" "" "${WORK}/watch.timeline")
  run_replay("${TEST_CONSUMER}" "${watch_resumed}" "LYNX_TEST_AV_WATCH_RESUME=1" "${WORK}/watch.timeline")
  compare_bundles("${watch_baseline}" "${watch_resumed}")
  message(STATUS "consumer.av_edges: zero-prefix and coincident/adjacent frame/sample edges matched across full/short spans and uninterrupted control; watch-clear-resume matched baseline")
elseif(CASE STREQUAL "consumer.av_restore")
