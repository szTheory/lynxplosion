cmake_minimum_required(VERSION 3.25)
cmake_policy(VERSION 3.25)
foreach(required ROOT WORK SCRATCH_ROOT CONSUMER ARTIFACT_CHECKER ENV_EXECUTABLE)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "av_driver: -D${required} is required")
  endif()
endforeach()
file(REAL_PATH "${ROOT}" canonical_root)
set(expected_scratch "${canonical_root}/build/check/scratch/consumer")
file(REAL_PATH "${SCRATCH_ROOT}" scratch_real)
cmake_path(NORMAL_PATH SCRATCH_ROOT OUTPUT_VARIABLE scratch_normal)
cmake_path(GET WORK PARENT_PATH work_parent)
cmake_path(GET WORK FILENAME work_name)
if(NOT scratch_normal STREQUAL expected_scratch OR NOT scratch_real STREQUAL expected_scratch OR
   NOT work_parent STREQUAL scratch_normal OR NOT work_name STREQUAL "consumer.av_tracer")
  message(FATAL_ERROR "av_driver: refusing scratch outside its owned check directory: ${WORK}")
endif()
set(SOURCE "${ROOT}/fixtures/diagnostic/av_probe.s")
set(CONFIG "${ROOT}/fixtures/diagnostic/av_probe.cfg")
set(MANIFEST "${ROOT}/fixtures/manifests/av-probe.manifest")
set(CA65 "${ROOT}/build/pins/cc65/bin/ca65")
set(LD65 "${ROOT}/build/pins/cc65/bin/ld65")
set(TOOL_FILES "${ROOT}/build/pins/cc65/.lynx-build-files")
if(NOT EXISTS "${CA65}" OR NOT EXISTS "${LD65}" OR NOT EXISTS "${TOOL_FILES}")
  message(FATAL_ERROR "av_driver: pinned ca65/ld65 build is missing; scripts/check.sh owns pin preparation")
endif()
file(STRINGS "${ROOT}/pins.txt" cc65_pin_row REGEX "^cc65 ")
list(LENGTH cc65_pin_row cc65_pin_count)
if(NOT cc65_pin_count EQUAL 1)
  message(FATAL_ERROR "av_driver: cc65 source pin is missing or ambiguous")
endif()
string(REGEX REPLACE "^[^ ]+ +[^ ]+ +[^ ]+ +([^ ]+)$" "\\1" cc65_pin "${cc65_pin_row}")
file(READ "${ROOT}/build/pins/cc65/.lynx-pin" cc65_pin_marker)
string(STRIP "${cc65_pin_marker}" cc65_pin_marker)
file(STRINGS "${ROOT}/build/pins/cc65/.lynx-build" cc65_stamp_pin REGEX "^pin_sha256 = ")
file(STRINGS "${ROOT}/build/pins/cc65/.lynx-build" cc65_stamp_recipe REGEX "^recipe = ")
file(STRINGS "${TOOL_FILES}" cc65_record_pin REGEX "^# pin_sha256 = ")
file(STRINGS "${TOOL_FILES}" cc65_record_recipe REGEX "^# recipe = ")
if(NOT cc65_pin_marker STREQUAL cc65_pin OR NOT cc65_stamp_pin STREQUAL "pin_sha256 = ${cc65_pin}" OR
   NOT cc65_stamp_recipe STREQUAL "recipe = 1" OR NOT cc65_record_pin STREQUAL "# pin_sha256 = ${cc65_pin}" OR
   NOT cc65_record_recipe STREQUAL "# recipe = 1")
  message(FATAL_ERROR "av_driver: cc65 build record is not bound to the pinned source and recipe")
endif()
file(SHA256 "${CA65}" ca65_sha)
file(SHA256 "${LD65}" ld65_sha)
file(STRINGS "${TOOL_FILES}" ca65_record REGEX "^[0-9a-f]+ bin/ca65$")
file(STRINGS "${TOOL_FILES}" ld65_record REGEX "^[0-9a-f]+ bin/ld65$")
if(NOT ca65_record MATCHES "^${ca65_sha} bin/ca65$" OR NOT ld65_record MATCHES "^${ld65_sha} bin/ld65$")
  message(FATAL_ERROR "av_driver: pinned assembler/linker bytes differ from their local successful build record")
endif()
file(SHA256 "${SOURCE}" source_sha)
file(SHA256 "${CONFIG}" config_sha)
file(STRINGS "${MANIFEST}" manifest_source REGEX "^sha256 = ")
file(STRINGS "${MANIFEST}" manifest_config REGEX "^av_config_sha256 = ")
if(NOT manifest_source STREQUAL "sha256 = ${source_sha}" OR
   NOT manifest_config STREQUAL "av_config_sha256 = ${config_sha}")
  message(FATAL_ERROR "av_driver: source/config disagree with the fixture provenance manifest")
endif()

# A malformed A/V provenance record must be rejected without activating the
# independent input-probe group or its fixture-specific 201-byte checks.
set(manifest_control "${WORK}-manifest-control")
file(MAKE_DIRECTORY "${manifest_control}/fixtures/manifests" "${manifest_control}/fixtures/diagnostic")
configure_file("${SOURCE}" "${manifest_control}/fixtures/diagnostic/av_probe.s" COPYONLY)
configure_file("${CONFIG}" "${manifest_control}/fixtures/diagnostic/av_probe.cfg" COPYONLY)
file(READ "${MANIFEST}" malformed_av_manifest)
string(REGEX REPLACE "\nav_guest_bytes = [^\n]*" "" malformed_av_manifest "${malformed_av_manifest}")
file(WRITE "${manifest_control}/fixtures/manifests/av-probe.manifest" "${malformed_av_manifest}")
execute_process(COMMAND sh "${ROOT}/scripts/check-manifests.sh" --root "${manifest_control}"
  TIMEOUT 30 RESULT_VARIABLE manifest_rc OUTPUT_VARIABLE manifest_out ERROR_VARIABLE manifest_err)
if(manifest_rc STREQUAL "0" OR
   NOT "${manifest_out}${manifest_err}" MATCHES "incomplete A/V provenance group: missing key: av_guest_bytes" OR
   "${manifest_out}${manifest_err}" MATCHES "incomplete input-probe provenance group")
  message(FATAL_ERROR "av_driver: malformed A/V provenance control failed unexpectedly (${manifest_rc})\n${manifest_out}${manifest_err}")
endif()
file(REMOVE_RECURSE "${manifest_control}")
file(MAKE_DIRECTORY "${SCRATCH_ROOT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(WORK "${WORK}-${nonce}")
execute_process(COMMAND "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin" mkdir "${WORK}"
  RESULT_VARIABLE mkdir_rc OUTPUT_VARIABLE mkdir_out ERROR_VARIABLE mkdir_err)
if(NOT mkdir_rc STREQUAL "0")
  message(FATAL_ERROR "av_driver: exclusive scratch creation failed: ${mkdir_out}${mkdir_err}")
endif()
execute_process(COMMAND "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin"
    "CC65_HOME=${ROOT}/build/pins/cc65" "${CA65}" --cpu 65SC02
    -o "${WORK}/av_probe.o" "${SOURCE}"
  WORKING_DIRECTORY "${WORK}" TIMEOUT 30 RESULT_VARIABLE ca_rc
  OUTPUT_VARIABLE ca_out ERROR_VARIABLE ca_err)
if(NOT ca_rc STREQUAL "0")
  message(FATAL_ERROR "av_driver: pinned ca65 failed to assemble av_probe.s\n${ca_out}${ca_err}")
endif()
execute_process(COMMAND "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin"
    "CC65_HOME=${ROOT}/build/pins/cc65" "${LD65}" -C "${CONFIG}"
    -Ln "${WORK}/av_probe.lbl" -o "${WORK}/av_probe.bll" "${WORK}/av_probe.o"
  WORKING_DIRECTORY "${WORK}" TIMEOUT 30 RESULT_VARIABLE ld_rc
  OUTPUT_VARIABLE ld_out ERROR_VARIABLE ld_err)
if(NOT ld_rc STREQUAL "0" OR NOT EXISTS "${WORK}/av_probe.bll" OR NOT EXISTS "${WORK}/av_probe.lbl")
  message(FATAL_ERROR "av_driver: pinned ld65 failed to link av_probe\n${ld_out}${ld_err}")
endif()
file(SHA256 "${WORK}/av_probe.bll" guest_sha)
file(SIZE "${WORK}/av_probe.bll" guest_size)
file(STRINGS "${MANIFEST}" manifest_guest REGEX "^av_guest_sha256 = ")
file(STRINGS "${MANIFEST}" manifest_guest_size REGEX "^av_guest_bytes = ")
if(NOT manifest_guest STREQUAL "av_guest_sha256 = ${guest_sha}" OR
   NOT manifest_guest_size STREQUAL "av_guest_bytes = ${guest_size}")
  message(FATAL_ERROR "av_driver: source-built BLL bytes differ from the project fixture manifest")
endif()
file(WRITE "${WORK}/input.timeline" "LYNX-INPUT 1\n109321 16\n")
file(SHA256 "${WORK}/input.timeline" input_sha)
set(output "${WORK}/output")
execute_process(COMMAND "${CONSUMER}" --mode av-replay --content "${WORK}/av_probe.bll"
    --symbols "${WORK}/av_probe.lbl" --timeline "${WORK}/input.timeline"
    --out "${output}" --profile none
  TIMEOUT 120 RESULT_VARIABLE consumer_rc OUTPUT_VARIABLE consumer_out ERROR_VARIABLE consumer_err)
if(NOT consumer_rc STREQUAL "0")
  message(FATAL_ERROR "av_driver: public-only A/V consumer failed (${consumer_rc})\n${consumer_out}${consumer_err}\nArtifacts retained under ${output}")
endif()
execute_process(COMMAND "${ARTIFACT_CHECKER}" av "${output}"
  TIMEOUT 30 RESULT_VARIABLE checker_rc OUTPUT_VARIABLE checker_out ERROR_VARIABLE checker_err)
if(NOT checker_rc STREQUAL "0")
  message(FATAL_ERROR "av_driver: independent A/V checker failed (${checker_rc})\n${checker_out}${checker_err}\nArtifacts retained under ${output}")
endif()
file(STRINGS "${output}/av.manifest" manifest_content REGEX "^content_sha256 = ")
file(STRINGS "${output}/av.manifest" manifest_input REGEX "^input_sha256 = ")
if(NOT manifest_content STREQUAL "content_sha256 = ${guest_sha}" OR
   NOT manifest_input STREQUAL "input_sha256 = ${input_sha}")
  message(FATAL_ERROR "av_driver: A/V manifest does not bind the exact guest and canonical input bytes")
endif()
foreach(name released.raw released.ppm pressed.raw pressed.ppm audio.pcm audio.wav audio.events)
  file(SHA256 "${output}/${name}" actual_sha)
  string(REPLACE "." "_" key "${name}")
  if(name STREQUAL "audio.pcm")
    set(key "pcm")
  elseif(name STREQUAL "audio.wav")
    set(key "wav")
  elseif(name STREQUAL "audio.events")
    set(key "events")
  endif()
  file(STRINGS "${output}/av.manifest" manifest_hash REGEX "^${key}_sha256 = ")
  if(NOT manifest_hash STREQUAL "${key}_sha256 = ${actual_sha}")
    message(FATAL_ERROR "av_driver: A/V manifest hash differs for ${name}")
  endif()
endforeach()
message(STATUS "consumer.av_tracer: source-built ${guest_size}-byte guest produced changed released/A raw and PPM frames plus non-silent 40000Hz stereo S16 spans; ca65=${ca65_sha}, ld65=${ld65_sha}")
file(REMOVE_RECURSE "${WORK}")
