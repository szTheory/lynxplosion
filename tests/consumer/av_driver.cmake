cmake_minimum_required(VERSION 3.25)
cmake_policy(VERSION 3.25)
foreach(required CASE ROOT WORK SCRATCH_ROOT CONSUMER TEST_CONSUMER ARTIFACT_CHECKER ENV_EXECUTABLE)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "av_driver: -D${required} is required")
  endif()
endforeach()
set(allowed_cases consumer.av_tracer consumer.av_controls consumer.av_edges consumer.av_restore
  consumer.av_publication_controls consumer.av_replay consumer.av_response_controls
  consumer.av_benchmark)
if(NOT CASE IN_LIST allowed_cases)
  message(FATAL_ERROR "av_driver: unsupported case '${CASE}'")
endif()
file(REAL_PATH "${ROOT}" canonical_root)
set(expected_scratch "${canonical_root}/build/check/scratch/consumer")
file(REAL_PATH "${SCRATCH_ROOT}" scratch_real)
cmake_path(NORMAL_PATH SCRATCH_ROOT OUTPUT_VARIABLE scratch_normal)
cmake_path(GET WORK PARENT_PATH work_parent)
cmake_path(GET WORK FILENAME work_name)
if(NOT scratch_normal STREQUAL expected_scratch OR NOT scratch_real STREQUAL expected_scratch OR
   NOT work_parent STREQUAL scratch_normal OR NOT work_name STREQUAL CASE)
  message(FATAL_ERROR "av_driver: refusing scratch outside its owned check directory: ${WORK}")
endif()
set(SOURCE "${ROOT}/fixtures/diagnostic/av_probe.s")
set(CONFIG "${ROOT}/fixtures/diagnostic/av_probe.cfg")
set(MANIFEST "${ROOT}/fixtures/manifests/av-probe.manifest")
set(CA65 "${ROOT}/build/pins/cc65/bin/ca65")
set(LD65 "${ROOT}/build/pins/cc65/bin/ld65")
set(TOOL_FILES "${ROOT}/build/pins/cc65/.lynx-build-files")
if(NOT EXISTS "${CA65}" OR NOT EXISTS "${LD65}" OR NOT EXISTS "${TOOL_FILES}")
  message(FATAL_ERROR "av_driver: pinned ca65/ld65 build is missing; scripts/check.sh owns pin preparation")
endif()
file(STRINGS "${ROOT}/pins.txt" cc65_pin_row REGEX "^cc65 ")
list(LENGTH cc65_pin_row cc65_pin_count)
if(NOT cc65_pin_count EQUAL 1)
  message(FATAL_ERROR "av_driver: cc65 source pin is missing or ambiguous")
endif()
string(REGEX REPLACE "^[^ ]+ +[^ ]+ +[^ ]+ +([^ ]+)$" "\\1" cc65_pin "${cc65_pin_row}")
file(READ "${ROOT}/build/pins/cc65/.lynx-pin" cc65_pin_marker)
string(STRIP "${cc65_pin_marker}" cc65_pin_marker)
file(STRINGS "${ROOT}/build/pins/cc65/.lynx-build" cc65_stamp_pin REGEX "^pin_sha256 = ")
file(STRINGS "${ROOT}/build/pins/cc65/.lynx-build" cc65_stamp_recipe REGEX "^recipe = ")
file(STRINGS "${TOOL_FILES}" cc65_record_pin REGEX "^# pin_sha256 = ")
file(STRINGS "${TOOL_FILES}" cc65_record_recipe REGEX "^# recipe = ")
if(NOT cc65_pin_marker STREQUAL cc65_pin OR NOT cc65_stamp_pin STREQUAL "pin_sha256 = ${cc65_pin}" OR
   NOT cc65_stamp_recipe STREQUAL "recipe = 1" OR NOT cc65_record_pin STREQUAL "# pin_sha256 = ${cc65_pin}" OR
   NOT cc65_record_recipe STREQUAL "# recipe = 1")
  message(FATAL_ERROR "av_driver: cc65 build record is not bound to the pinned source and recipe")
endif()
file(SHA256 "${CA65}" ca65_sha)
file(SHA256 "${LD65}" ld65_sha)
file(STRINGS "${TOOL_FILES}" ca65_record REGEX "^[0-9a-f]+ bin/ca65$")
file(STRINGS "${TOOL_FILES}" ld65_record REGEX "^[0-9a-f]+ bin/ld65$")
if(NOT ca65_record MATCHES "^${ca65_sha} bin/ca65$" OR NOT ld65_record MATCHES "^${ld65_sha} bin/ld65$")
  message(FATAL_ERROR "av_driver: pinned assembler/linker bytes differ from their local successful build record")
endif()
file(SHA256 "${SOURCE}" source_sha)
file(SHA256 "${CONFIG}" config_sha)
file(STRINGS "${MANIFEST}" manifest_source REGEX "^sha256 = ")
file(STRINGS "${MANIFEST}" manifest_config REGEX "^av_config_sha256 = ")
if(NOT manifest_source STREQUAL "sha256 = ${source_sha}" OR
   NOT manifest_config STREQUAL "av_config_sha256 = ${config_sha}")
  message(FATAL_ERROR "av_driver: source/config disagree with the fixture provenance manifest")
endif()

# A malformed A/V provenance record must be rejected without activating the
# independent input-probe group or its fixture-specific 201-byte checks.
set(manifest_control "${WORK}-manifest-control")
file(MAKE_DIRECTORY "${manifest_control}/fixtures/manifests" "${manifest_control}/fixtures/diagnostic")
configure_file("${SOURCE}" "${manifest_control}/fixtures/diagnostic/av_probe.s" COPYONLY)
configure_file("${CONFIG}" "${manifest_control}/fixtures/diagnostic/av_probe.cfg" COPYONLY)
file(READ "${MANIFEST}" malformed_av_manifest)
string(REGEX REPLACE "\nav_guest_bytes = [^\n]*" "" malformed_av_manifest "${malformed_av_manifest}")
file(WRITE "${manifest_control}/fixtures/manifests/av-probe.manifest" "${malformed_av_manifest}")
execute_process(COMMAND sh "${ROOT}/scripts/check-manifests.sh" --root "${manifest_control}"
  TIMEOUT 30 RESULT_VARIABLE manifest_rc OUTPUT_VARIABLE manifest_out ERROR_VARIABLE manifest_err)
if(manifest_rc STREQUAL "0" OR
   NOT "${manifest_out}${manifest_err}" MATCHES "incomplete A/V provenance group: missing key: av_guest_bytes" OR
   "${manifest_out}${manifest_err}" MATCHES "incomplete input-probe provenance group")
  message(FATAL_ERROR "av_driver: malformed A/V provenance control failed unexpectedly (${manifest_rc})\n${manifest_out}${manifest_err}")
endif()
file(REMOVE_RECURSE "${manifest_control}")
file(MAKE_DIRECTORY "${SCRATCH_ROOT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(WORK "${WORK}-${nonce}")
execute_process(COMMAND "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin" mkdir "${WORK}"
  RESULT_VARIABLE mkdir_rc OUTPUT_VARIABLE mkdir_out ERROR_VARIABLE mkdir_err)
if(NOT mkdir_rc STREQUAL "0")
  message(FATAL_ERROR "av_driver: exclusive scratch creation failed: ${mkdir_out}${mkdir_err}")
endif()
set(work_owner "${WORK}/.lynx-av-driver-owner")
file(WRITE "${work_owner}" "${nonce}\n")
execute_process(COMMAND "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin"
    "CC65_HOME=${ROOT}/build/pins/cc65" "${CA65}" --cpu 65SC02
    -o "${WORK}/av_probe.o" "${SOURCE}"
  WORKING_DIRECTORY "${WORK}" TIMEOUT 30 RESULT_VARIABLE ca_rc
  OUTPUT_VARIABLE ca_out ERROR_VARIABLE ca_err)
if(NOT ca_rc STREQUAL "0")
  message(FATAL_ERROR "av_driver: pinned ca65 failed to assemble av_probe.s\n${ca_out}${ca_err}")
endif()
execute_process(COMMAND "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin"
    "CC65_HOME=${ROOT}/build/pins/cc65" "${LD65}" -C "${CONFIG}"
    -Ln "${WORK}/av_probe.lbl" -o "${WORK}/av_probe.bll" "${WORK}/av_probe.o"
  WORKING_DIRECTORY "${WORK}" TIMEOUT 30 RESULT_VARIABLE ld_rc
  OUTPUT_VARIABLE ld_out ERROR_VARIABLE ld_err)
if(NOT ld_rc STREQUAL "0" OR NOT EXISTS "${WORK}/av_probe.bll" OR NOT EXISTS "${WORK}/av_probe.lbl")
  message(FATAL_ERROR "av_driver: pinned ld65 failed to link av_probe\n${ld_out}${ld_err}")
endif()
file(SHA256 "${WORK}/av_probe.bll" guest_sha)
file(SIZE "${WORK}/av_probe.bll" guest_size)
file(STRINGS "${MANIFEST}" manifest_guest REGEX "^av_guest_sha256 = ")
file(STRINGS "${MANIFEST}" manifest_guest_size REGEX "^av_guest_bytes = ")
if(NOT manifest_guest STREQUAL "av_guest_sha256 = ${guest_sha}" OR
   NOT manifest_guest_size STREQUAL "av_guest_bytes = ${guest_size}")
  message(FATAL_ERROR "av_driver: source-built BLL bytes differ from the project fixture manifest")
endif()
function(run_replay binary output control)
  set(input_timeline "${WORK}/input.timeline")
  if(ARGC GREATER 3)
    set(input_timeline "${ARGV3}")
  endif()
  set(command "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin")
  if(NOT "${control}" STREQUAL "")
    list(APPEND command "${control}")
  endif()
  list(APPEND command "${binary}" --mode av-replay --content "${WORK}/av_probe.bll"
    --symbols "${WORK}/av_probe.lbl" --timeline "${input_timeline}"
    --out "${output}" --profile none)
  execute_process(COMMAND ${command} TIMEOUT 120 RESULT_VARIABLE run_rc
    OUTPUT_VARIABLE run_out ERROR_VARIABLE run_err)
  if(NOT "${run_rc}" STREQUAL "0")
    message(FATAL_ERROR "${CASE}: replay failed (${run_rc})\n${run_out}${run_err}\nArtifacts retained under ${output}")
  endif()
endfunction()

function(run_benchmark binary output report)
  set(command "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin" "${binary}"
    --mode av-benchmark --content "${WORK}/av_probe.bll"
    --symbols "${WORK}/av_probe.lbl" --timeline "${WORK}/input.timeline"
    --out "${output}" --profile none)
  execute_process(COMMAND ${command} TIMEOUT 120 RESULT_VARIABLE run_rc
    OUTPUT_VARIABLE run_out ERROR_VARIABLE run_err)
  if(NOT "${run_rc}" STREQUAL "0" OR NOT run_out MATCHES "^format=LYNX-BENCHMARK-1\n")
    message(FATAL_ERROR "${CASE}: benchmark replay failed (${run_rc})\n${run_out}${run_err}\nArtifacts retained under ${output}")
  endif()
  file(WRITE "${report}" "${run_out}")
endfunction()

function(benchmark_field report key out_value out_error)
  string(REPLACE "\n" ";" report_lines "${report}")
  set(matches)
  foreach(line IN LISTS report_lines)
    if(line MATCHES "^${key}=(.*)$")
      list(APPEND matches "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  list(LENGTH matches match_count)
  if(match_count EQUAL 0)
    set(${out_value} "" PARENT_SCOPE)
    set(${out_error} "missing benchmark field: ${key}" PARENT_SCOPE)
    return()
  elseif(NOT match_count EQUAL 1)
    set(${out_value} "" PARENT_SCOPE)
    set(${out_error} "duplicate benchmark field: ${key}" PARENT_SCOPE)
    return()
  endif()
  list(GET matches 0 value)
  set(${out_value} "${value}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(benchmark_uint report key require_positive out_value out_error)
  benchmark_field("${report}" "${key}" value field_error)
  if(NOT field_error STREQUAL "")
    set(${out_value} "" PARENT_SCOPE)
    set(${out_error} "${field_error}" PARENT_SCOPE)
    return()
  endif()
  if(require_positive)
    if(NOT value MATCHES "^[1-9][0-9]*$")
      set(${out_value} "" PARENT_SCOPE)
      set(${out_error} "benchmark field ${key} must be a positive decimal integer" PARENT_SCOPE)
      return()
    endif()
  elseif(NOT value MATCHES "^(0|[1-9][0-9]*)$")
    set(${out_value} "" PARENT_SCOPE)
    set(${out_error} "benchmark field ${key} is not a canonical decimal integer" PARENT_SCOPE)
    return()
  endif()
  string(LENGTH "${value}" value_length)
  if(value_length GREATER 19 OR
     (value_length EQUAL 19 AND "${value}" STRGREATER "9223372036854775807"))
    set(${out_value} "" PARENT_SCOPE)
    set(${out_error} "benchmark field ${key} overflows the supported integer range" PARENT_SCOPE)
    return()
  endif()
  set(${out_value} "${value}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(benchmark_digest report key out_value out_error)
  benchmark_field("${report}" "${key}" value field_error)
  if(NOT field_error STREQUAL "")
    set(${out_value} "" PARENT_SCOPE)
    set(${out_error} "${field_error}" PARENT_SCOPE)
    return()
  endif()
  string(LENGTH "${value}" value_length)
  if(NOT value MATCHES "^[0-9a-f]+$" OR NOT value_length EQUAL 64)
    set(${out_value} "" PARENT_SCOPE)
    set(${out_error} "benchmark field ${key} is not a lowercase SHA-256 digest" PARENT_SCOPE)
    return()
  endif()
  set(${out_value} "${value}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(benchmark_validate_record report out_error)
  foreach(key format build_id profile timing_policy audio_policy clock content_sha256 timeline_sha256 combined_output_sha256)
    benchmark_field("${report}" "${key}" value field_error)
    if(NOT field_error STREQUAL "")
      set(${out_error} "${field_error}" PARENT_SCOPE)
      return()
    endif()
    if(key STREQUAL "format" AND NOT value STREQUAL "LYNX-BENCHMARK-1")
      set(${out_error} "unsupported benchmark report format" PARENT_SCOPE)
      return()
    elseif(key STREQUAL "profile" AND NOT value MATCHES "^(none|lynx1|lynx2)$")
      set(${out_error} "unsupported benchmark profile" PARENT_SCOPE)
      return()
    elseif(key STREQUAL "timing_policy" AND NOT value STREQUAL "video-policy1-unverified")
      set(${out_error} "unsupported benchmark timing policy" PARENT_SCOPE)
      return()
    elseif(key STREQUAL "audio_policy" AND NOT value STREQUAL "digital-1")
      set(${out_error} "unsupported benchmark audio policy" PARENT_SCOPE)
      return()
    elseif(key STREQUAL "clock" AND NOT value STREQUAL "CLOCK_MONOTONIC")
      set(${out_error} "benchmark clock is not monotonic" PARENT_SCOPE)
      return()
    elseif(key STREQUAL "build_id" AND value STREQUAL "")
      set(${out_error} "benchmark build identity is empty" PARENT_SCOPE)
      return()
    endif()
    if(key MATCHES "_sha256$")
      benchmark_digest("${report}" "${key}" ignored digest_error)
      if(NOT digest_error STREQUAL "")
        set(${out_error} "${digest_error}" PARENT_SCOPE)
        return()
      endif()
    endif()
  endforeach()

  benchmark_field("${report}" "guest_ticks" guest_ticks_raw field_error)
  if(NOT field_error STREQUAL "")
    set(${out_error} "${field_error}" PARENT_SCOPE)
    return()
  elseif(guest_ticks_raw STREQUAL "0")
    set(${out_error} "benchmark report has no guest progress" PARENT_SCOPE)
    return()
  endif()
  benchmark_field("${report}" "api_advance_calls" advance_calls_raw field_error)
  if(NOT field_error STREQUAL "")
    set(${out_error} "${field_error}" PARENT_SCOPE)
    return()
  elseif(advance_calls_raw STREQUAL "0")
    set(${out_error} "benchmark report has no guest progress" PARENT_SCOPE)
    return()
  endif()

  set(positive_fields input_event_count input_applied_count guest_endpoint_tick guest_window_bound_tick guest_ticks
    api_advance_calls api_advance_ns api_first_start_ns api_last_end_ns
    frame_encode_calls frame_encode_ns frame_encode_first_start_ns frame_encode_last_end_ns
    frames_count pcm_frames_count audio_events_count api_advance_output_sample_ordinal
    stream_count assembly_ns assembly_start_ns assembly_end_ns publication_ns
    publication_start_ns publication_end_ns replay_total_ns replay_start_ns replay_end_ns)
  foreach(key IN LISTS positive_fields)
    benchmark_uint("${report}" "${key}" TRUE value field_error)
    if(NOT field_error STREQUAL "")
      set(${out_error} "${field_error}" PARENT_SCOPE)
      return()
    endif()
    set("${key}_value" "${value}")
  endforeach()
  if(NOT stream_count_value EQUAL 13 OR NOT input_event_count_value EQUAL input_applied_count_value OR
     NOT guest_ticks_value EQUAL guest_endpoint_tick_value OR
     NOT frame_encode_calls_value EQUAL frames_count_value OR
     guest_endpoint_tick_value GREATER guest_window_bound_tick_value)
    set(${out_error} "benchmark report has inconsistent guest work counts" PARENT_SCOPE)
    return()
  endif()

  if(api_last_end_ns_value LESS_EQUAL api_first_start_ns_value OR
     replay_start_ns_value GREATER api_first_start_ns_value OR
     api_last_end_ns_value GREATER assembly_start_ns_value OR
     replay_start_ns_value GREATER frame_encode_first_start_ns_value OR
     frame_encode_first_start_ns_value GREATER frame_encode_last_end_ns_value OR
     frame_encode_last_end_ns_value GREATER replay_end_ns_value OR
     assembly_start_ns_value GREATER_EQUAL assembly_end_ns_value OR
     assembly_end_ns_value GREATER publication_start_ns_value OR
     publication_start_ns_value GREATER_EQUAL publication_end_ns_value OR
     publication_end_ns_value GREATER replay_end_ns_value)
    set(${out_error} "benchmark monotonic timestamps are inconsistent" PARENT_SCOPE)
    return()
  endif()
  math(EXPR api_span "${api_last_end_ns_value} - ${api_first_start_ns_value}")
  math(EXPR assembly_span "${assembly_end_ns_value} - ${assembly_start_ns_value}")
  math(EXPR publication_span "${publication_end_ns_value} - ${publication_start_ns_value}")
  math(EXPR replay_span "${replay_end_ns_value} - ${replay_start_ns_value}")
  if(api_advance_ns_value GREATER api_span OR NOT assembly_ns_value EQUAL assembly_span OR
     NOT publication_ns_value EQUAL publication_span OR NOT replay_total_ns_value EQUAL replay_span)
    set(${out_error} "benchmark durations disagree with monotonic clock boundaries" PARENT_SCOPE)
    return()
  endif()

  set(expected_streams released.raw released.ppm pressed.raw pressed.ppm frames.raw frames.ppm
    input.timeline input.applied guest.progress audio.pcm audio.wav audio.events av.manifest)
  foreach(index RANGE 0 12)
    benchmark_field("${report}" "stream_${index}_name" stream_name field_error)
    if(NOT field_error STREQUAL "")
      set(${out_error} "${field_error}" PARENT_SCOPE)
      return()
    endif()
    list(GET expected_streams ${index} expected_name)
    if(NOT stream_name STREQUAL expected_name)
      set(${out_error} "benchmark output stream inventory is invalid" PARENT_SCOPE)
      return()
    endif()
    benchmark_uint("${report}" "stream_${index}_bytes" TRUE ignored field_error)
    if(NOT field_error STREQUAL "")
      set(${out_error} "${field_error}" PARENT_SCOPE)
      return()
    endif()
    benchmark_digest("${report}" "stream_${index}_sha256" ignored field_error)
    if(NOT field_error STREQUAL "")
      set(${out_error} "${field_error}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(benchmark_check_bundle report output)
  set(material "")
  foreach(index RANGE 0 12)
    benchmark_field("${report}" "stream_${index}_name" stream_name field_error)
    benchmark_uint("${report}" "stream_${index}_bytes" TRUE reported_bytes size_error)
    benchmark_digest("${report}" "stream_${index}_sha256" reported_sha digest_error)
    if(NOT field_error STREQUAL "" OR NOT size_error STREQUAL "" OR NOT digest_error STREQUAL "")
      message(FATAL_ERROR "${CASE}: malformed per-stream benchmark identity: ${field_error}${size_error}${digest_error}")
    endif()
    file(SIZE "${output}/${stream_name}" actual_bytes)
    file(SHA256 "${output}/${stream_name}" actual_sha)
    if(NOT "${actual_bytes}" STREQUAL "${reported_bytes}" OR NOT actual_sha STREQUAL reported_sha)
      message(FATAL_ERROR "${CASE}: benchmark report does not match ${stream_name}")
    endif()
    string(APPEND material "${stream_name}\n${reported_bytes}\n${reported_sha}\n")
  endforeach()
  string(SHA256 expected_combined "${material}")
  benchmark_field("${report}" combined_output_sha256 reported_combined combined_error)
  if(NOT combined_error STREQUAL "" OR NOT reported_combined STREQUAL expected_combined)
    message(FATAL_ERROR "${CASE}: combined output digest does not bind the complete stream inventory")
  endif()
endfunction()

function(expect_benchmark_no_run)
  file(WRITE "${WORK}/no-run.timeline" "LYNX-INPUT 1\n")
  set(output "${WORK}/output-no-run")
  execute_process(COMMAND "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin"
      "${TEST_CONSUMER}" --mode av-benchmark --content "${WORK}/av_probe.bll"
      --symbols "${WORK}/av_probe.lbl" --timeline "${WORK}/no-run.timeline"
      --out "${output}" --profile none
    TIMEOUT 60 RESULT_VARIABLE run_rc OUTPUT_VARIABLE run_out ERROR_VARIABLE run_err)
  if(NOT "${run_rc}" STREQUAL "1" OR
     NOT "${run_out}${run_err}" MATCHES "A/V replay needs a bounded timeline containing an A press" OR
     "${run_out}" MATCHES "^format=LYNX-BENCHMARK-1" OR EXISTS "${output}")
    message(FATAL_ERROR "${CASE}: no-run benchmark control did not refuse before publishing a report or bundle (${run_rc})\n${run_out}${run_err}")
  endif()
endfunction()

function(benchmark_environment out_record)
  execute_process(COMMAND uname -r RESULT_VARIABLE release_rc OUTPUT_VARIABLE host_release
    ERROR_VARIABLE release_err OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT release_rc STREQUAL "0")
    message(FATAL_ERROR "${CASE}: could not identify host OS release: ${release_err}")
  endif()
  if(HOST_OS STREQUAL "Darwin")
    execute_process(COMMAND /usr/sbin/sysctl -n machdep.cpu.brand_string
      RESULT_VARIABLE cpu_rc OUTPUT_VARIABLE host_cpu ERROR_VARIABLE cpu_err
      OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT cpu_rc STREQUAL "0" OR host_cpu STREQUAL "")
      execute_process(COMMAND /usr/sbin/sysctl -n hw.model
        RESULT_VARIABLE cpu_rc OUTPUT_VARIABLE host_cpu ERROR_VARIABLE cpu_err
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    endif()
  elseif(HOST_OS STREQUAL "Linux" AND EXISTS "/proc/cpuinfo")
    file(STRINGS "/proc/cpuinfo" cpu_lines REGEX "^model name[ \t]*:")
    if(cpu_lines)
      list(GET cpu_lines 0 host_cpu)
      string(REGEX REPLACE "^[^:]*:[ \t]*" "" host_cpu "${host_cpu}")
      set(cpu_rc "0")
    else()
      set(cpu_rc "1")
    endif()
  else()
    set(host_cpu "${HOST_ARCH}")
    set(cpu_rc "0")
  endif()
  string(STRIP "${host_cpu}" host_cpu)
  if(NOT cpu_rc STREQUAL "0" OR host_cpu STREQUAL "")
    if(HOST_ARCH STREQUAL "")
      message(FATAL_ERROR "${CASE}: could not identify host hardware: ${cpu_err}")
    endif()
    set(host_cpu "${HOST_OS} ${HOST_ARCH} (exact CPU model unavailable)")
  endif()
  if(BUILD_TYPE STREQUAL "")
    set(build_type "unspecified")
  else()
    set(build_type "${BUILD_TYPE}")
  endif()
  set(${out_record} "host_os=${HOST_OS}\nhost_release=${host_release}\nhost_arch=${HOST_ARCH}\nhost_cpu_model=${host_cpu}\ncompiler_id=${C_COMPILER_ID}\ncompiler_version=${C_COMPILER_VERSION}\nbuild_type=${build_type}\n" PARENT_SCOPE)
endfunction()

function(benchmark_stable_signature record out_signature out_error)
  set(signature "")
  set(stable_fields format build_id profile timing_policy audio_policy clock content_sha256
    timeline_sha256 input_event_count input_applied_count guest_endpoint_tick guest_window_bound_tick guest_ticks
    api_advance_calls frame_encode_calls frames_count pcm_frames_count audio_events_count
    api_advance_output_sample_ordinal stream_count combined_output_sha256
    host_os host_release host_arch host_cpu_model compiler_id compiler_version build_type)
  foreach(index RANGE 0 12)
    list(APPEND stable_fields "stream_${index}_name" "stream_${index}_bytes" "stream_${index}_sha256")
  endforeach()
  foreach(key IN LISTS stable_fields)
    benchmark_field("${record}" "${key}" value field_error)
    if(NOT field_error STREQUAL "")
      set(${out_signature} "" PARENT_SCOPE)
      set(${out_error} "${field_error}" PARENT_SCOPE)
      return()
    endif()
    string(APPEND signature "${key}=${value}\n")
  endforeach()
  set(${out_signature} "${signature}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(benchmark_validate_corpus corpus out_error out_signature)
  string(REPLACE "\n--RUN--\n" ";" records "${corpus}")
  list(LENGTH records record_count)
  if(NOT record_count EQUAL 5)
    set(${out_error} "benchmark corpus must contain exactly five runs" PARENT_SCOPE)
    set(${out_signature} "" PARENT_SCOPE)
    return()
  endif()
  set(run_ids)
  set(reference_signature "")
  set(record_index 0)
  foreach(record IN LISTS records)
    benchmark_field("${record}" "run_id" run_id field_error)
    if(NOT field_error STREQUAL "")
      set(${out_error} "${field_error}" PARENT_SCOPE)
      set(${out_signature} "" PARENT_SCOPE)
      return()
    endif()
    if(NOT run_id MATCHES "^[1-5]$")
      set(${out_error} "benchmark run IDs must be exactly 1 through 5" PARENT_SCOPE)
      set(${out_signature} "" PARENT_SCOPE)
      return()
    endif()
    if(run_id IN_LIST run_ids)
      set(${out_error} "benchmark run IDs must be unique" PARENT_SCOPE)
      set(${out_signature} "" PARENT_SCOPE)
      return()
    endif()
    list(APPEND run_ids "${run_id}")
    benchmark_validate_record("${record}" record_error)
    if(NOT record_error STREQUAL "")
      set(${out_error} "${record_error}" PARENT_SCOPE)
      set(${out_signature} "" PARENT_SCOPE)
      return()
    endif()
    benchmark_stable_signature("${record}" signature signature_error)
    if(NOT signature_error STREQUAL "")
      set(${out_error} "${signature_error}" PARENT_SCOPE)
      set(${out_signature} "" PARENT_SCOPE)
      return()
    endif()
    if(record_index EQUAL 0)
      set(reference_signature "${signature}")
    elseif(NOT signature STREQUAL reference_signature)
      set(${out_error} "benchmark runs have unequal identity, workload, or output digests" PARENT_SCOPE)
      set(${out_signature} "" PARENT_SCOPE)
      return()
    endif()
    math(EXPR record_index "${record_index} + 1")
  endforeach()
  list(SORT run_ids COMPARE NATURAL)
  if(NOT "${run_ids}" STREQUAL "1;2;3;4;5")
    set(${out_error} "benchmark run IDs must be exactly 1 through 5" PARENT_SCOPE)
    set(${out_signature} "" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
  set(${out_signature} "${reference_signature}" PARENT_SCOPE)
endfunction()

function(run_expected_refusal control expected output)
  set(input_timeline "${WORK}/input.timeline")
  if(ARGC GREATER 3)
    set(input_timeline "${ARGV3}")
  endif()
  set(command "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin")
  if(NOT "${control}" STREQUAL "")
    list(APPEND command "${control}")
  endif()
  list(APPEND command "${TEST_CONSUMER}" --mode av-replay --content "${WORK}/av_probe.bll"
    --symbols "${WORK}/av_probe.lbl" --timeline "${input_timeline}"
    --out "${output}" --profile none)
  execute_process(COMMAND ${command} TIMEOUT 120 RESULT_VARIABLE run_rc
    OUTPUT_VARIABLE run_out ERROR_VARIABLE run_err)
  if("${run_rc}" STREQUAL "0" OR NOT "${run_out}${run_err}" MATCHES "${expected}")
    message(FATAL_ERROR "${CASE}: refusal control '${control}' did not fail at its named assertion (${run_rc})\n${run_out}${run_err}")
  endif()
  if(EXISTS "${output}")
    message(FATAL_ERROR "${CASE}: refusal control '${control}' published output before rejecting the checkpoint")
  endif()
endfunction()

function(expect_av_publication_failure output expected)
  set(command "${ENV_EXECUTABLE}" -i "PATH=/usr/bin:/bin")
  foreach(control IN LISTS ARGN)
    list(APPEND command "${control}")
  endforeach()
  list(APPEND command "${TEST_CONSUMER}" --mode av-replay --content "${WORK}/av_probe.bll"
    --symbols "${WORK}/av_probe.lbl" --timeline "${WORK}/input.timeline"
    --out "${output}" --profile none)
  string(JOIN "," control_summary ${ARGN})
  string(TIMESTAMP child_start "%Y-%m-%dT%H:%M:%S" UTC)
  file(APPEND "${publication_progress}" "child-start ${control_summary} ${child_start}\n")
  execute_process(COMMAND ${command} TIMEOUT 120 RESULT_VARIABLE failure_rc
    OUTPUT_VARIABLE failure_out ERROR_VARIABLE failure_err)
  string(TIMESTAMP child_end "%Y-%m-%dT%H:%M:%S" UTC)
  file(WRITE "${output}.child.status" "${failure_rc}\n")
  file(WRITE "${output}.child.stdout" "${failure_out}")
  file(WRITE "${output}.child.stderr" "${failure_err}")
  file(APPEND "${publication_progress}" "child-end ${control_summary} rc=${failure_rc} ${child_end}\n")
  file(GLOB leftover_stages "${output}.lynxplosion-av-stage-*")
  if(NOT failure_rc STREQUAL "1" OR EXISTS "${output}" OR leftover_stages OR
     NOT "${failure_out}${failure_err}" MATCHES "${expected}")
    message(FATAL_ERROR "${CASE}: A/V publication failure did not preserve an absent destination and clean its owned stage (${failure_rc})\n${failure_out}${failure_err}\nleftover stages: ${leftover_stages}")
  endif()
endfunction()

function(compare_bundles left right)
  foreach(name input.timeline input.applied guest.progress audio.pcm audio.wav audio.events av.manifest
      released.raw released.ppm pressed.raw pressed.ppm frames.raw frames.ppm)
    if(NOT EXISTS "${left}/${name}" OR NOT EXISTS "${right}/${name}")
      message(FATAL_ERROR "${CASE}: complete replay bundle is missing ${name}")
    endif()
    file(SIZE "${left}/${name}" left_size)
    file(SIZE "${right}/${name}" right_size)
    file(SHA256 "${left}/${name}" left_hash)
    file(SHA256 "${right}/${name}" right_hash)
    if(NOT left_size EQUAL right_size OR NOT left_hash STREQUAL right_hash)
      message(FATAL_ERROR "${CASE}: restored and control replay differ in ${name}")
    endif()
  endforeach()
endfunction()

function(check_stream_identity directory filename size_key sha_key)
  file(SIZE "${directory}/${filename}" actual_size)
  file(SHA256 "${directory}/${filename}" actual_sha)
  file(STRINGS "${directory}/av.manifest" manifest_size REGEX "^${size_key} = ")
  file(STRINGS "${directory}/av.manifest" manifest_sha REGEX "^${sha_key} = ")
  list(LENGTH manifest_size size_count)
  list(LENGTH manifest_sha sha_count)
  if(NOT size_count EQUAL 1 OR NOT sha_count EQUAL 1 OR
     NOT manifest_size STREQUAL "${size_key} = ${actual_size}" OR
     NOT manifest_sha STREQUAL "${sha_key} = ${actual_sha}")
    message(FATAL_ERROR "${CASE}: av.manifest does not bind ${filename} to its exact extent and bytes")
  endif()
endfunction()

function(check_replay_bundle directory timeline_sha)
  file(STRINGS "${directory}/av.manifest" content_identity REGEX "^content_sha256 = ")
  file(STRINGS "${directory}/av.manifest" input_identity REGEX "^input_sha256 = ")
  file(STRINGS "${directory}/av.manifest" timeline_identity REGEX "^timeline_sha256 = ")
  file(STRINGS "${directory}/av.manifest" timeline_stream_identity REGEX "^timeline_stream_sha256 = ")
  if(NOT content_identity STREQUAL "content_sha256 = ${guest_sha}" OR
     NOT input_identity STREQUAL "input_sha256 = ${timeline_sha}" OR
     NOT timeline_identity STREQUAL "timeline_sha256 = ${timeline_sha}" OR
     NOT timeline_stream_identity STREQUAL "timeline_stream_sha256 = ${timeline_sha}")
    message(FATAL_ERROR "${CASE}: manifest content/timeline identity does not match the source-built guest and canonical input")
  endif()
  check_stream_identity("${directory}" input.timeline input_bytes input_sha256)
  check_stream_identity("${directory}" input.applied input_applied_bytes input_applied_sha256)
  check_stream_identity("${directory}" guest.progress guest_progress_bytes guest_progress_sha256)
  check_stream_identity("${directory}" frames.raw frames_raw_bytes frames_raw_sha256)
  check_stream_identity("${directory}" frames.ppm frames_ppm_bytes frames_ppm_sha256)
  check_stream_identity("${directory}" released.raw released_raw_bytes released_raw_sha256)
  check_stream_identity("${directory}" released.ppm released_ppm_bytes released_ppm_sha256)
  check_stream_identity("${directory}" pressed.raw pressed_raw_bytes pressed_raw_sha256)
  check_stream_identity("${directory}" pressed.ppm pressed_ppm_bytes pressed_ppm_sha256)
  check_stream_identity("${directory}" audio.pcm pcm_bytes pcm_sha256)
  check_stream_identity("${directory}" audio.wav wav_bytes wav_sha256)
  check_stream_identity("${directory}" audio.events events_bytes events_sha256)
  execute_process(COMMAND "${ARTIFACT_CHECKER}" av-replay "${directory}" "${guest_sha}" "${timeline_sha}"
    TIMEOUT 30 RESULT_VARIABLE checker_rc OUTPUT_VARIABLE checker_out ERROR_VARIABLE checker_err)
  if(NOT checker_rc STREQUAL "0")
    message(FATAL_ERROR "${CASE}: independent full-stream checker failed (${checker_rc})\n${checker_out}${checker_err}\nArtifacts retained under ${directory}")
  endif()
endfunction()

function(expect_replay_rejection directory expected)
  execute_process(COMMAND "${ARTIFACT_CHECKER}" av-replay "${directory}" "${guest_sha}" "${timeline_sha}"
    TIMEOUT 30 RESULT_VARIABLE checker_rc OUTPUT_VARIABLE checker_out ERROR_VARIABLE checker_err)
  if(checker_rc STREQUAL "0" OR NOT "${checker_out}${checker_err}" MATCHES "${expected}")
    message(FATAL_ERROR "${CASE}: mutation was not rejected at '${expected}' (${checker_rc})\n${checker_out}${checker_err}")
  endif()
endfunction()

function(replace_text_file path before after)
  file(READ "${path}" original)
  string(FIND "${original}" "${before}" position)
  if(position LESS 0)
    message(FATAL_ERROR "${CASE}: mutation source text is absent from ${path}")
  endif()
  string(REPLACE "${before}" "${after}" updated "${original}")
  if(updated STREQUAL original)
    message(FATAL_ERROR "${CASE}: requested mutation made no change to ${path}")
  endif()
  file(WRITE "${path}" "${updated}")
endfunction()

