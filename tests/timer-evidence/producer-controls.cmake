# Operates only on this invocation's nonce-owned package; backups stay outside it.
find_program(DD_EXECUTABLE dd REQUIRED)
function(expect_builder_refusal label mode path diagnostic)
  execute_process(COMMAND "${ENV_EXECUTABLE}" -i PATH=/usr/bin:/bin LC_ALL=C "TMPDIR=${RUN_DIR}/tmp"
      sh "${ROOT}/scripts/build-timer-evidence.sh" "${mode}" "${path}"
    TIMEOUT 10 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  record_stage("producer-${label}" "${rc}" "${out}" "${err}")
  if(NOT rc STREQUAL "1" OR NOT err MATCHES "${diagnostic}")
    message(FATAL_ERROR "timer_evidence: ${label} did not reach its intended refusal; retained ${run_log}\n${out}${err}")
  endif()
endfunction()

set(case_name hardware-dma1-page1)
file(CHMOD "${RUN_DIR}/package" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
expect_builder_refusal(public-package --verify "${RUN_DIR}/package" "owner-only mode 0700")
file(CHMOD "${RUN_DIR}/package" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
set(image "${RUN_DIR}/package/${case_name}.bll")
set(case_record "${RUN_DIR}/package/${case_name}.case.txt")
set(build_record "${RUN_DIR}/package/build-record.txt")
foreach(path "${image}" "${case_record}" "${build_record}")
  get_filename_component(leaf "${path}" NAME)
  configure_file("${path}" "${RUN_DIR}/original-${leaf}" COPYONLY)
endforeach()
file(READ "${RUN_DIR}/package/${case_name}.lbl" labels)
string(REGEX MATCH "al ([0-9A-Fa-f]+) \\.suite_dispctl_restore[\r\n]" restore_match "${labels}")
if(NOT restore_match)
  message(FATAL_ERROR "timer_evidence: control restore label missing")
endif()
math(EXPR restore_offset "0x${CMAKE_MATCH_1} - 512 + 10 + 1")
foreach(fault code entry restore extension)
  foreach(path "${image}" "${case_record}" "${build_record}")
    get_filename_component(leaf "${path}" NAME)
    configure_file("${RUN_DIR}/original-${leaf}" "${path}" COPYONLY)
  endforeach()
  if(fault STREQUAL "code")
    set(offset 125)
    set(diagnostic "CODE no longer matches pinned baseline")
  elseif(fault STREQUAL "entry")
    set(offset 10)
    set(diagnostic "entry must begin SEI\\+JMP")
  elseif(fault STREQUAL "restore")
    set(offset "${restore_offset}")
    set(diagnostic "display restore does not match its family")
  else()
    # First glyph byte is nonzero and outside all structural entry checks.
    string(REGEX MATCH "al ([0-9A-Fa-f]+) \\.suite_glyphs[\r\n]" glyph_match "${labels}")
    if(NOT glyph_match)
      message(FATAL_ERROR "timer_evidence: control glyph label missing")
    endif()
    math(EXPR offset "0x${CMAKE_MATCH_1} - 512 + 10")
    set(diagnostic "complete image differs from approved source build")
  endif()
  file(READ "${image}" before_byte OFFSET ${offset} LIMIT 1 HEX)
  if(before_byte STREQUAL "00")
    message(FATAL_ERROR "timer_evidence: ${fault} mutation would not change a byte")
  endif()
  execute_process(COMMAND "${DD_EXECUTABLE}" if=/dev/zero "of=${image}" bs=1 "seek=${offset}" count=1 conv=notrunc
    RESULT_VARIABLE dd_rc ERROR_QUIET)
  execute_process(COMMAND "${DD_EXECUTABLE}" "if=${image}" "of=${RUN_DIR}/code.bin" bs=1 skip=125 count=487
    RESULT_VARIABLE code_rc ERROR_QUIET)
  if(NOT dd_rc STREQUAL "0" OR NOT code_rc STREQUAL "0")
    message(FATAL_ERROR "timer_evidence: unable to create producer control")
  endif()
  file(SHA256 "${image}" object_sha)
  file(SHA256 "${RUN_DIR}/code.bin" code_sha)
  foreach(path "${case_record}" "${build_record}")
    file(READ "${path}" record)
    string(REGEX REPLACE "(object_sha256|${case_name}_bll_sha256)=[0-9a-f]+" "\\1=${object_sha}" record "${record}")
    string(REGEX REPLACE "(pinned_code_sha256|${case_name}_code_sha256)=[0-9a-f]+" "\\1=${code_sha}" record "${record}")
    file(WRITE "${path}" "${record}")
  endforeach()
  expect_builder_refusal("${fault}-with-refreshed-records" --verify "${RUN_DIR}/package" "${diagnostic}")
endforeach()
foreach(path "${image}" "${case_record}" "${build_record}")
  get_filename_component(leaf "${path}" NAME)
  configure_file("${RUN_DIR}/original-${leaf}" "${path}" COPYONLY)
endforeach()

# Refuse non-regular entries before attempting to read any receipt.
execute_process(COMMAND mkfifo "${RUN_DIR}/package/unknown-pipe" RESULT_VARIABLE fifo_rc)
if(NOT fifo_rc STREQUAL "0")
  message(FATAL_ERROR "timer_evidence: unable to create FIFO control")
endif()
expect_builder_refusal(fifo --verify "${RUN_DIR}/package" "non-regular package entry")
file(REMOVE "${RUN_DIR}/package/unknown-pipe")
file(WRITE "${RUN_DIR}/sentinel" "unchanged\n")
file(SHA256 "${RUN_DIR}/sentinel" sentinel_sha)
file(CREATE_LINK "${RUN_DIR}/sentinel" "${RUN_DIR}/package/unknown-link" SYMBOLIC)
expect_builder_refusal(symlink-entry --verify "${RUN_DIR}/package" "non-regular package entry")
file(REMOVE "${RUN_DIR}/package/unknown-link")
file(CREATE_LINK "${RUN_DIR}/tmp" "${RUN_DIR}/linked-parent" SYMBOLIC)
expect_builder_refusal(symlink-ancestor --out "${RUN_DIR}/linked-parent/output" "symlink output ancestor")
expect_builder_refusal(foreign-output --out "${ROOT}/timer-evidence-control-must-not-exist" "outside owned scratch")
if(EXISTS "${ROOT}/timer-evidence-control-must-not-exist" OR EXISTS "${RUN_DIR}/tmp/output")
  message(FATAL_ERROR "timer_evidence: refused output created a directory")
endif()
file(SHA256 "${RUN_DIR}/sentinel" sentinel_after)
if(NOT sentinel_sha STREQUAL sentinel_after)
  message(FATAL_ERROR "timer_evidence: refusal changed sentinel")
endif()
execute_process(COMMAND "${ENV_EXECUTABLE}" -i PATH=/usr/bin:/bin LC_ALL=C "TMPDIR=${RUN_DIR}/tmp"
    sh "${ROOT}/scripts/build-timer-evidence.sh" --verify "${RUN_DIR}/package"
  TIMEOUT 10 RESULT_VARIABLE restored_rc OUTPUT_VARIABLE restored_out ERROR_VARIABLE restored_err)
record_stage("producer-restored-positive" "${restored_rc}" "${restored_out}" "${restored_err}")
if(NOT restored_rc STREQUAL "0")
  message(FATAL_ERROR "timer_evidence: restored package verification failed; retained ${run_log}")
endif()
