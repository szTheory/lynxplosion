cmake_minimum_required(VERSION 3.25)
cmake_policy(VERSION 3.25)

foreach(required MODE ROOT WORK SCRATCH_ROOT TEST_BINARY)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "timer_evidence: -D${required} is required")
  endif()
endforeach()
if(NOT MODE STREQUAL "tracer")
  message(FATAL_ERROR "timer_evidence: unknown mode")
endif()
foreach(path_name ROOT WORK SCRATCH_ROOT)
  if(NOT IS_ABSOLUTE "${${path_name}}")
    message(FATAL_ERROR "timer_evidence: ${path_name} must be absolute")
  endif()
endforeach()

function(assert_no_symlink_ancestors label path)
  set(cursor "${path}")
  while(TRUE)
    if(IS_SYMLINK "${cursor}")
      message(FATAL_ERROR "timer_evidence: refusing symlink ancestor in ${label}")
    endif()
    get_filename_component(parent "${cursor}" DIRECTORY)
    if(parent STREQUAL cursor)
      break()
    endif()
    set(cursor "${parent}")
  endwhile()
endfunction()

assert_no_symlink_ancestors("ROOT" "${ROOT}")
assert_no_symlink_ancestors("SCRATCH_ROOT" "${SCRATCH_ROOT}")
assert_no_symlink_ancestors("WORK" "${WORK}")
file(REAL_PATH "${ROOT}" root_real)
file(REAL_PATH "${SCRATCH_ROOT}" scratch_real)
if(NOT root_real STREQUAL ROOT OR NOT scratch_real STREQUAL SCRATCH_ROOT)
  message(FATAL_ERROR "timer_evidence: ROOT and SCRATCH_ROOT must be canonical")
endif()
cmake_path(IS_PREFIX SCRATCH_ROOT "${WORK}" NORMALIZE work_owned)
if(NOT work_owned OR WORK STREQUAL SCRATCH_ROOT)
  message(FATAL_ERROR "timer_evidence: WORK is outside invocation-owned scratch")
endif()
get_filename_component(work_parent "${WORK}" DIRECTORY)
file(MAKE_DIRECTORY "${work_parent}")
file(MAKE_DIRECTORY "${WORK}")
file(REAL_PATH "${WORK}" work_real)
if(NOT work_real STREQUAL WORK)
  message(FATAL_ERROR "timer_evidence: WORK resolved through a symlink")
endif()

string(RANDOM LENGTH 48 ALPHABET 0123456789abcdef nonce)
set(RUN_DIR "${WORK}/run-${nonce}")
if(EXISTS "${RUN_DIR}" OR IS_SYMLINK "${RUN_DIR}")
  message(FATAL_ERROR "timer_evidence: refusing colliding invocation directory")
endif()
file(MAKE_DIRECTORY "${RUN_DIR}/tmp")
file(REAL_PATH "${RUN_DIR}" run_real)
if(NOT run_real STREQUAL RUN_DIR)
  message(FATAL_ERROR "timer_evidence: invocation directory is not canonical")
endif()
set(owner_marker "${RUN_DIR}/.lynx-timer-run-owner")
file(WRITE "${owner_marker}" "lynx-timer-run-v1\n${RUN_DIR}\n${nonce}\n")
set(run_log "${RUN_DIR}/run.log")
find_program(ENV_EXECUTABLE env REQUIRED)

function(record_stage stage result output error)
  file(APPEND "${run_log}" "stage=${stage}\nexit=${result}\nstdout_begin\n${output}stdout_end\nstderr_begin\n${error}stderr_end\n")
endfunction()

execute_process(COMMAND "${ENV_EXECUTABLE}" -i PATH=/usr/bin:/bin LC_ALL=C "TMPDIR=${RUN_DIR}/tmp"
    sh "${ROOT}/scripts/build-timer-evidence.sh" --out "${RUN_DIR}/package"
  TIMEOUT 60 RESULT_VARIABLE build_rc OUTPUT_VARIABLE build_out ERROR_VARIABLE build_err)
record_stage("build" "${build_rc}" "${build_out}" "${build_err}")
if(NOT build_rc STREQUAL "0")
  message(FATAL_ERROR "timer_evidence: package build failed (${build_rc}); private failure log retained at ${run_log}\n${build_out}${build_err}")
endif()

execute_process(COMMAND "${TEST_BINARY}" --tracer "${RUN_DIR}/package"
  TIMEOUT 45 RESULT_VARIABLE tracer_rc OUTPUT_VARIABLE tracer_out ERROR_VARIABLE tracer_err)
record_stage("tracer" "${tracer_rc}" "${tracer_out}" "${tracer_err}")
if(NOT tracer_rc STREQUAL "0")
  message(FATAL_ERROR "timer_evidence: tracer failed (${tracer_rc}); private failure log retained at ${run_log}\n${tracer_out}${tracer_err}")
endif()

execute_process(COMMAND "${ENV_EXECUTABLE}" -i PATH=/usr/bin:/bin LC_ALL=C "TMPDIR=${RUN_DIR}/tmp"
    sh "${ROOT}/scripts/build-timer-evidence.sh" --verify "${RUN_DIR}/package"
  TIMEOUT 60 RESULT_VARIABLE verify_rc OUTPUT_VARIABLE verify_out ERROR_VARIABLE verify_err)
record_stage("verify" "${verify_rc}" "${verify_out}" "${verify_err}")
if(NOT verify_rc STREQUAL "0")
  message(FATAL_ERROR "timer_evidence: package verification failed (${verify_rc}); private failure log retained at ${run_log}\n${verify_out}${verify_err}")
endif()

assert_no_symlink_ancestors("cleanup run directory" "${RUN_DIR}")
file(REAL_PATH "${RUN_DIR}" cleanup_real)
if(NOT cleanup_real STREQUAL RUN_DIR OR NOT EXISTS "${owner_marker}" OR IS_SYMLINK "${owner_marker}")
  message(FATAL_ERROR "timer_evidence: invocation cleanup ownership check failed")
endif()
file(READ "${owner_marker}" owner_value)
if(NOT owner_value STREQUAL "lynx-timer-run-v1\n${RUN_DIR}\n${nonce}\n")
  message(FATAL_ERROR "timer_evidence: invocation owner marker changed")
endif()
file(REMOVE_RECURSE "${RUN_DIR}")
if(EXISTS "${RUN_DIR}" OR IS_SYMLINK "${RUN_DIR}")
  message(FATAL_ERROR "timer_evidence: unable to clean successful scratch")
endif()
message(STATUS "timer_evidence: source build, two-profile capture/raster decode and hardware refusal passed")
