function(source_manifest root excluded_relative output_var)
  file(GLOB_RECURSE inputs LIST_DIRECTORIES FALSE
       "${root}/core/*" "${root}/include/*")
  list(APPEND inputs "${root}/tests/suzy/test_suzy.c" "${root}/tests/check.h")
  if(FAULT_TARGET STREQUAL "suite")
    list(APPEND inputs "${root}/tests/suites/test_public_suites.c")
  endif()
  list(SORT inputs)
  set(serialized "")
  foreach(input IN LISTS inputs)
    file(REAL_PATH "${input}" real_input)
    file(RELATIVE_PATH relative "${root}" "${real_input}")
    if(relative STREQUAL "core/build_id.c" OR relative STREQUAL "${excluded_relative}")
      continue()
    endif()
    file(SHA256 "${input}" input_sha256)
    string(APPEND serialized "${relative}=${input_sha256}\n")
  endforeach()
  string(SHA256 manifest_sha256 "${serialized}")
  set(${output_var} "${manifest_sha256}" PARENT_SCOPE)
endfunction()

function(file_inode path output_var)
  if(APPLE)
    execute_process(COMMAND /usr/bin/stat -f "%d:%i" "${path}"
      RESULT_VARIABLE stat_result OUTPUT_VARIABLE inode ERROR_VARIABLE stat_error
      OUTPUT_STRIP_TRAILING_WHITESPACE)
  else()
    execute_process(COMMAND stat -c "%d:%i" "${path}"
      RESULT_VARIABLE stat_result OUTPUT_VARIABLE inode ERROR_VARIABLE stat_error
      OUTPUT_STRIP_TRAILING_WHITESPACE)
  endif()
  if(NOT "${stat_result}" STREQUAL "0" OR "${inode}" STREQUAL "")
    message(FATAL_ERROR "Suzy fault control: could not identify executable ${path}: ${stat_error}")
  endif()
  set(${output_var} "${inode}" PARENT_SCOPE)
endfunction()

function(check_clean_case stage output_failure output_seconds)
  string(TIMESTAMP started "%s" UTC)
  if(FAULT_TARGET STREQUAL "suite")
    execute_process(COMMAND "${clean_binary}" observe math-memio math lynx1
      "${CLEAN_SUITE_BUILD}" "${MATH_ORACLE}"
      RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
    if("${result}" STREQUAL "0")
      execute_process(COMMAND "${clean_binary}" validate-math-memio-strict-record math lynx1
        "${CLEAN_SUITE_BUILD}" "${MATH_ORACLE}"
        RESULT_VARIABLE validation_result OUTPUT_VARIABLE validation_out ERROR_VARIABLE validation_err TIMEOUT 30)
      set(out "${out}${validation_out}")
      set(err "${err}${validation_err}")
      if(NOT "${validation_result}" STREQUAL "0")
        set(result "${validation_result}")
      endif()
    endif()
  else()
    execute_process(COMMAND "${clean_binary}" "${TEST_CASE}"
      RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
  endif()
  string(TIMESTAMP ended "%s" UTC)
  math(EXPR elapsed "${ended} - ${started}")
  set(output "${out}${err}")
  file(SHA256 "${clean_binary}" current_binary_sha256)
  file_inode("${clean_binary}" current_inode)
  file(SHA256 "${source_root}/${MUTANT_SOURCE}" current_source_sha256)
  if(NOT "${result}" STREQUAL "0" OR
     output MATCHES "ASSERT [^\r\n]* failed|AddressSanitizer|UndefinedBehaviorSanitizer|runtime error:" OR
     NOT current_binary_sha256 STREQUAL baseline_binary_sha256 OR
     NOT current_inode STREQUAL baseline_inode OR
     NOT current_source_sha256 STREQUAL clean_source_sha256)
    set(${output_failure} "${stage} clean positive failed: exit=${result} binary=${current_binary_sha256}@${current_inode} source=${current_source_sha256}\n${output}" PARENT_SCOPE)
    set(${output_seconds} "${elapsed}" PARENT_SCOPE)
    return()
  endif()
  set(${output_failure} "" PARENT_SCOPE)
  set(${output_seconds} "${elapsed}" PARENT_SCOPE)
endfunction()

