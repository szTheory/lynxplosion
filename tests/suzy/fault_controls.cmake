file(SHA256 "${build_root}/generated/build_id.c" source_build_id_sha256)
file(SHA256 "${variant_source}/core/build_id.c" copied_build_id_sha256)
if(NOT copied_build_id_sha256 STREQUAL source_build_id_sha256)
  message(FATAL_ERROR "Suzy fault control: copied build identity differs; retained at ${scratch}")
endif()
source_manifest("${variant_source}" "${MUTANT_SOURCE}" copied_manifest_sha256)
if(NOT copied_manifest_sha256 STREQUAL clean_manifest_sha256)
  message(FATAL_ERROR "Suzy fault control: copied non-mutant source identity differs; retained at ${scratch}")
endif()

set(mutated_file "${variant_source}/${MUTANT_SOURCE}")
file(READ "${mutated_file}" source_before)
file(SHA256 "${mutated_file}" copied_source_sha256)
if(NOT copied_source_sha256 STREQUAL clean_source_sha256)
  message(FATAL_ERROR "Suzy fault control: copied source identity differs; retained at ${scratch}")
endif()
string(LENGTH "${anchor}" anchor_length)
set(anchor_rest "${source_before}")
set(anchor_count 0)
while(TRUE)
  string(FIND "${anchor_rest}" "${anchor}" anchor_position)
  if(anchor_position EQUAL -1)
    break()
  endif()
  math(EXPR anchor_count "${anchor_count} + 1")
  math(EXPR next_position "${anchor_position} + ${anchor_length}")
  string(SUBSTRING "${anchor_rest}" ${next_position} -1 anchor_rest)
endwhile()
if(NOT anchor_count EQUAL 1)
  message(FATAL_ERROR "Suzy fault control: ${MUTANT_SOURCE} anchor count is ${anchor_count}; expected one; retained at ${scratch}")
endif()
string(REPLACE "${anchor}" "${replacement}" source_mutated "${source_before}")
if(source_mutated STREQUAL source_before)
  message(FATAL_ERROR "Suzy fault control: ${FAULT_ID} did not mutate copied source; retained at ${scratch}")
endif()
file(WRITE "${mutated_file}" "${source_mutated}")
file(SHA256 "${mutated_file}" mutant_source_sha256)
if(mutant_source_sha256 STREQUAL clean_source_sha256)
  message(FATAL_ERROR "Suzy fault control: mutant source identity did not change; retained at ${scratch}")
endif()
source_manifest("${variant_source}" "${MUTANT_SOURCE}" mutant_manifest_sha256)
if(NOT mutant_manifest_sha256 STREQUAL clean_manifest_sha256)
  message(FATAL_ERROR "Suzy fault control: non-mutated source identity changed; retained at ${scratch}")
endif()

