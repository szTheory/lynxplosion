  message(FATAL_ERROR "audio fault control: generated build identity is missing")
endif()

function(source_manifest root excluded_relative output_var)
  file(GLOB_RECURSE inputs LIST_DIRECTORIES FALSE
       "${root}/core/*" "${root}/include/*")
  list(APPEND inputs "${root}/tests/audio/test_audio.c")
  list(SORT inputs)
  set(serialized "")
  foreach(input IN LISTS inputs)
    file(REAL_PATH "${input}" real_input)
    file(RELATIVE_PATH relative "${root}" "${real_input}")
    if(relative STREQUAL "core/build_id.c" OR relative STREQUAL "${excluded_relative}")
      continue()
    endif()
    file(SHA256 "${input}" input_sha256)
    string(APPEND serialized "${relative}=${input_sha256}\n")
  endforeach()
  string(SHA256 manifest_sha256 "${serialized}")
  set(${output_var} "${manifest_sha256}" PARENT_SCOPE)
endfunction()

function(file_inode path output_var)
  if(APPLE)
    execute_process(COMMAND /usr/bin/stat -f "%d:%i" "${path}"
      RESULT_VARIABLE stat_result OUTPUT_VARIABLE inode ERROR_VARIABLE stat_error
      OUTPUT_STRIP_TRAILING_WHITESPACE)
  else()
    execute_process(COMMAND stat -c "%d:%i" "${path}"
      RESULT_VARIABLE stat_result OUTPUT_VARIABLE inode ERROR_VARIABLE stat_error
      OUTPUT_STRIP_TRAILING_WHITESPACE)
  endif()
  if(NOT "${stat_result}" STREQUAL "0" OR "${inode}" STREQUAL "")
    message(FATAL_ERROR "audio fault control: could not identify executable ${path}: ${stat_error}")
  endif()
  set(${output_var} "${inode}" PARENT_SCOPE)
endfunction()

function(check_clean_case stage output_failure output_seconds)
  string(TIMESTAMP started "%s" UTC)
  execute_process(COMMAND "${clean_binary}" "${TEST_CASE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
  string(TIMESTAMP ended "%s" UTC)
  math(EXPR elapsed "${ended} - ${started}")
  set(output "${out}${err}")
  file(SHA256 "${clean_binary}" current_binary_sha256)
  file_inode("${clean_binary}" current_inode)
  file(SHA256 "${source_root}/${MUTANT_SOURCE}" current_source_sha256)
  if(NOT "${result}" STREQUAL "0" OR output MATCHES "ASSERT [^\r\n]* failed|AddressSanitizer|UndefinedBehaviorSanitizer|runtime error:" OR
     NOT current_binary_sha256 STREQUAL baseline_binary_sha256 OR
     NOT current_inode STREQUAL baseline_inode OR
     NOT current_source_sha256 STREQUAL clean_source_sha256)
    set(${output_failure} "${stage} clean positive failed: exit=${result} binary=${current_binary_sha256}@${current_inode} source=${current_source_sha256}\n${output}" PARENT_SCOPE)
    set(${output_seconds} "${elapsed}" PARENT_SCOPE)
    return()
  endif()
  set(${output_failure} "" PARENT_SCOPE)
  set(${output_seconds} "${elapsed}" PARENT_SCOPE)
endfunction()

file(MAKE_DIRECTORY "${build_root}/scratch")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef invocation_nonce)
set(scratch "${build_root}/scratch/audio-fault-${FAULT_ID}-${invocation_nonce}")
set(owner_file "${scratch}/.lynx-fault-owner")
set(owner_value "source=${source_root}\nfault=${FAULT_ID}\nnonce=${invocation_nonce}\n")
if(EXISTS "${scratch}" OR IS_SYMLINK "${scratch}")
  message(FATAL_ERROR "audio fault control: unique invocation scratch already exists")
endif()
file(MAKE_DIRECTORY "${scratch}")
file(WRITE "${owner_file}" "${owner_value}")

file(SHA256 "${source_root}/${MUTANT_SOURCE}" clean_source_sha256)
source_manifest("${source_root}" "${MUTANT_SOURCE}" clean_manifest_sha256)
file(SHA256 "${clean_binary}" baseline_binary_sha256)
file_inode("${clean_binary}" baseline_inode)
file(REAL_PATH "${clean_binary}" clean_binary_path)

check_clean_case("before mutation" failure_before positive_before_seconds)
if(NOT "${failure_before}" STREQUAL "")
  message(FATAL_ERROR "audio fault control: ${failure_before}; retained at ${scratch}")
endif()

set(variant_source "${scratch}/src")
set(variant_build "${scratch}/build")
file(MAKE_DIRECTORY "${variant_source}/tests/audio")
file(COPY "${source_root}/core" "${source_root}/include" DESTINATION "${variant_source}")
file(COPY_FILE "${source_root}/tests/audio/test_audio.c"
     "${variant_source}/tests/audio/test_audio.c")
file(COPY_FILE "${build_root}/generated/build_id.c"
     "${variant_source}/core/build_id.c")
file(SHA256 "${build_root}/generated/build_id.c" source_build_id_sha256)
file(SHA256 "${variant_source}/core/build_id.c" copied_build_id_sha256)
if(NOT copied_build_id_sha256 STREQUAL source_build_id_sha256)
  message(FATAL_ERROR "audio fault control: copied build identity differs from the current build; retained at ${scratch}")
endif()
source_manifest("${variant_source}" "${MUTANT_SOURCE}" copied_manifest_sha256)
if(NOT copied_manifest_sha256 STREQUAL clean_manifest_sha256)
  message(FATAL_ERROR "audio fault control: copied non-mutant source identity differs; retained at ${scratch}")
endif()

set(mutated_file "${variant_source}/${MUTANT_SOURCE}")
file(READ "${mutated_file}" source_before)
file(SHA256 "${mutated_file}" copied_source_sha256)
if(NOT copied_source_sha256 STREQUAL clean_source_sha256)
  message(FATAL_ERROR "audio fault control: copied source identity differs before mutation; retained at ${scratch}")
endif()
string(LENGTH "${anchor}" anchor_length)
set(anchor_rest "${source_before}")
set(anchor_count 0)
while(TRUE)
  string(FIND "${anchor_rest}" "${anchor}" anchor_position)
  if(anchor_position EQUAL -1)
    break()
  endif()
  math(EXPR anchor_count "${anchor_count} + 1")
  math(EXPR next_position "${anchor_position} + ${anchor_length}")
  string(SUBSTRING "${anchor_rest}" ${next_position} -1 anchor_rest)
endwhile()
if(NOT anchor_count EQUAL 1)
  message(FATAL_ERROR "audio fault control: ${MUTANT_SOURCE} anchor count is ${anchor_count}; expected exactly one; retained at ${scratch}")
endif()
string(REPLACE "${anchor}" "${replacement}" source_mutated "${source_before}")
if(source_mutated STREQUAL source_before)
  message(FATAL_ERROR "audio fault control: ${FAULT_ID} did not change the copied source; retained at ${scratch}")
endif()
file(WRITE "${mutated_file}" "${source_mutated}")
file(SHA256 "${mutated_file}" mutant_source_sha256)
if(mutant_source_sha256 STREQUAL clean_source_sha256)
  message(FATAL_ERROR "audio fault control: mutant source identity did not change; retained at ${scratch}")
endif()
source_manifest("${variant_source}" "${MUTANT_SOURCE}" mutant_manifest_sha256)
if(NOT mutant_manifest_sha256 STREQUAL clean_manifest_sha256)
  message(FATAL_ERROR "audio fault control: a non-mutated source input changed; retained at ${scratch}")
endif()

file(WRITE "${variant_source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.25)
project(lynx_audio_fault LANGUAGES C)
set(CMAKE_C_STANDARD 17)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS OFF)
