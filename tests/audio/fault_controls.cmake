  tests/audio/test_audio.c
  core/audio.c core/bus.c core/cpu.c core/cpu_profile.c core/input.c
  core/machine.c core/sha256.c core/snapshot.c core/timer.c core/video.c
  core/build_id.c)
target_include_directories(lynx-test-audio PRIVATE include core)
target_compile_options(lynx-test-audio PRIVATE
  -Wall -Wextra -Wpedantic -pedantic-errors -Wconversion -Wshadow -Werror
  -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer
  -ffile-prefix-map=${CMAKE_CURRENT_SOURCE_DIR}=.
  -ffile-prefix-map=${CMAKE_CURRENT_BINARY_DIR}=build)
target_link_options(lynx-test-audio PRIVATE -fsanitize=address,undefined)
]=])

set(mutant_binary "${variant_build}/lynx-test-audio")
if(EXISTS "${mutant_binary}" OR IS_SYMLINK "${mutant_binary}")
  message(FATAL_ERROR "audio fault control: refusing to replace an existing mutant executable; retained at ${scratch}")
endif()
file(SHA256 "${variant_source}/CMakeLists.txt" mutant_config_sha256)
file(SHA256 "${variant_source}/core/build_id.c" build_id_sha256)
string(TIMESTAMP configure_started "%s" UTC)
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${variant_source}" -B "${variant_build}" -G Ninja
    "-DCMAKE_C_COMPILER=${C_COMPILER}"
  RESULT_VARIABLE configure_result OUTPUT_VARIABLE configure_out ERROR_VARIABLE configure_err TIMEOUT 60)
if(NOT "${configure_result}" STREQUAL "0")
  message(FATAL_ERROR "audio fault control: mutant configure failed, not semantic detection: ${configure_result}\n${configure_out}${configure_err}; retained at ${scratch}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${variant_build}" --target lynx-test-audio
  RESULT_VARIABLE build_result OUTPUT_VARIABLE build_out ERROR_VARIABLE build_err TIMEOUT 120)
if(NOT "${build_result}" STREQUAL "0")
  message(FATAL_ERROR "audio fault control: mutant compile/link failed, not semantic detection: ${build_result}\n${build_out}${build_err}; retained at ${scratch}")
endif()
string(TIMESTAMP build_ended "%s" UTC)
math(EXPR build_seconds "${build_ended} - ${configure_started}")
if(NOT EXISTS "${mutant_binary}" OR IS_SYMLINK "${mutant_binary}")
  message(FATAL_ERROR "audio fault control: mutant executable is missing or a symlink; retained at ${scratch}")
endif()
file(SHA256 "${mutant_binary}" mutant_binary_sha256)
file(REAL_PATH "${mutant_binary}" mutant_binary_path)
file_inode("${mutant_binary}" mutant_inode)
if(mutant_binary_path STREQUAL clean_binary_path OR mutant_inode STREQUAL baseline_inode)
  message(FATAL_ERROR "audio fault control: mutant executable did not receive an independent fresh path/inode; retained at ${scratch}")
endif()

string(TIMESTAMP mutant_started "%s" UTC)
execute_process(COMMAND "${mutant_binary}" "${TEST_CASE}"
  RESULT_VARIABLE mutant_result OUTPUT_VARIABLE mutant_out ERROR_VARIABLE mutant_err TIMEOUT 30)
string(TIMESTAMP mutant_ended "%s" UTC)
math(EXPR mutant_seconds "${mutant_ended} - ${mutant_started}")
set(mutant_output "${mutant_out}${mutant_err}")
string(REGEX MATCHALL "ASSERT [^\r\n]* failed" assertion_lines "${mutant_output}")
list(LENGTH assertion_lines assertion_count)
set(expected_assertion_count 0)
foreach(assertion IN LISTS assertion_lines)
  if(assertion MATCHES "^ASSERT ${assertion_pattern} failed")
    math(EXPR expected_assertion_count "${expected_assertion_count} + 1")
  endif()
endforeach()
if("${mutant_result}" STREQUAL "Process terminated due to timeout" OR
   mutant_output MATCHES "AddressSanitizer|UndefinedBehaviorSanitizer|runtime error:" OR
   NOT "${mutant_result}" STREQUAL "1" OR assertion_count LESS 1 OR
   NOT assertion_count EQUAL expected_assertion_count)
  message(FATAL_ERROR "audio fault control: ${FAULT_ID} did not fail only ${assertion_id}, exit=${mutant_result}, assertions=${assertion_count}/${expected_assertion_count}\n${mutant_output}; retained at ${scratch}")
endif()

check_clean_case("after mutation" failure_after positive_after_seconds)
if(NOT "${failure_after}" STREQUAL "")
  message(FATAL_ERROR "audio fault control: ${failure_after}; retained at ${scratch}")
endif()
file(SHA256 "${source_root}/${MUTANT_SOURCE}" final_source_sha256)
source_manifest("${source_root}" "${MUTANT_SOURCE}" final_manifest_sha256)
if(NOT final_source_sha256 STREQUAL clean_source_sha256 OR
   NOT final_manifest_sha256 STREQUAL clean_manifest_sha256)
  message(FATAL_ERROR "audio fault control: production source identity changed; retained at ${scratch}")
endif()

file(REAL_PATH "${scratch}" final_scratch_root)
string(FIND "${final_scratch_root}/" "${build_root}/" contained_at)
if(NOT contained_at EQUAL 0 OR final_scratch_root STREQUAL build_root OR
   IS_SYMLINK "${scratch}" OR IS_SYMLINK "${owner_file}" OR NOT EXISTS "${owner_file}")
  message(FATAL_ERROR "audio fault control: invocation owner/containment proof failed; retained at ${scratch}")
endif()
file(READ "${owner_file}" final_owner)
if(NOT final_owner STREQUAL owner_value)
  message(FATAL_ERROR "audio fault control: invocation owner changed; retained at ${scratch}")
endif()
file(REMOVE_RECURSE "${final_scratch_root}")
if(EXISTS "${scratch}" OR IS_SYMLINK "${scratch}")
  message(FATAL_ERROR "audio fault control: verified scratch cleanup did not complete")
endif()
message(STATUS "audio fault proof: ${FAULT_ID} assertion=${assertion_id} exit=1 clean_source=${clean_source_sha256} mutant_source=${mutant_source_sha256} nonmutant_manifest=${clean_manifest_sha256} baseline_binary=${baseline_binary_sha256}@${baseline_inode} mutant_binary=${mutant_binary_sha256}@${mutant_inode} configure_build_s=${build_seconds} mutant_s=${mutant_seconds} clean_before_after_s=${positive_before_seconds}/${positive_after_seconds} nonce=${invocation_nonce} scratch=removed-after-owner-check")
