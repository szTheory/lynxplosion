# Small script-mode helper for converting committed text byte fixtures into
# temporary binary BS93/BLL objects. No generated content is committed.
include_guard(GLOBAL)
find_program(LYNX_BLL_SH_EXECUTABLE sh REQUIRED)

function(_lynx_bll_hex_byte out value)
  math(EXPR high "${value} / 16")
  math(EXPR low "${value} % 16")
  string(SUBSTRING "0123456789abcdef" ${high} 1 high_hex)
  string(SUBSTRING "0123456789abcdef" ${low} 1 low_hex)
  set(${out} "${high_hex}${low_hex}" PARENT_SCOPE)
endfunction()

function(lynx_write_binary_hex hex_text path)
  string(REGEX REPLACE "#[^\r\n]*" "" bytes_hex "${hex_text}")
  string(REGEX REPLACE "[ \t\r\n]" "" bytes_hex "${bytes_hex}")
  string(LENGTH "${bytes_hex}" hex_len)
  if(hex_len EQUAL 0 OR hex_len GREATER 131070 OR NOT bytes_hex MATCHES "^[0-9A-Fa-f]+$")
    message(FATAL_ERROR "BLL helper: malformed or oversized byte sequence")
  endif()
  math(EXPR odd "${hex_len} % 2")
  if(NOT odd EQUAL 0)
    message(FATAL_ERROR "BLL helper: byte sequence has an odd number of hex digits")
  endif()
  math(EXPR byte_count "${hex_len} / 2")
  math(EXPR last_byte "${byte_count} - 1")
  set(octal_bytes "")
  foreach(i RANGE 0 ${last_byte})
    math(EXPR at "${i} * 2")
    string(SUBSTRING "${bytes_hex}" ${at} 2 byte_hex)
    math(EXPR byte "0x${byte_hex}")
    math(EXPR digit1 "${byte} / 64")
    math(EXPR remainder "${byte} % 64")
    math(EXPR digit2 "${remainder} / 8")
    math(EXPR digit3 "${remainder} % 8")
    string(APPEND octal_bytes "\\${digit1}${digit2}${digit3}")
  endforeach()
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env "${LYNX_BLL_SH_EXECUTABLE}" -c "printf '%b' '${octal_bytes}'"
    OUTPUT_FILE "${path}" RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "BLL helper: could not write ${path}: ${err}")
  endif()
  file(SIZE "${path}" written_len)
  if(NOT written_len EQUAL byte_count)
    message(FATAL_ERROR "BLL helper: wrote ${written_len} bytes to ${path}, expected ${byte_count}")
  endif()
endfunction()

function(lynx_build_bll_hex out payload_hex load_addr)
  string(REGEX REPLACE "#[^\r\n]*" "" payload "${payload_hex}")
  string(REGEX REPLACE "[ \t\r\n]" "" payload "${payload}")
  string(LENGTH "${payload}" payload_hex_len)
  if(payload_hex_len EQUAL 0 OR payload_hex_len GREATER 131050 OR
     NOT payload MATCHES "^[0-9A-Fa-f]+$")
    message(FATAL_ERROR "BLL helper: payload is malformed, empty or too large")
  endif()
  math(EXPR odd "${payload_hex_len} % 2")
  if(NOT odd EQUAL 0)
    message(FATAL_ERROR "BLL helper: payload has an odd number of hex digits")
  endif()
  math(EXPR payload_len "${payload_hex_len} / 2")
  math(EXPR object_len "${payload_len} + 10")
  math(EXPR address "${load_addr}")
  if(address LESS 0 OR address GREATER 65535 OR object_len GREATER 65535)
    message(FATAL_ERROR "BLL helper: address or object length is not representable")
  endif()
  math(EXPR address_hi "${address} / 256")
  math(EXPR address_lo "${address} % 256")
  math(EXPR length_hi "${object_len} / 256")
  math(EXPR length_lo "${object_len} % 256")
  _lynx_bll_hex_byte(address_hi_hex "${address_hi}")
  _lynx_bll_hex_byte(address_lo_hex "${address_lo}")
  _lynx_bll_hex_byte(length_hi_hex "${length_hi}")
  _lynx_bll_hex_byte(length_lo_hex "${length_lo}")
  set(object_hex "8008${address_hi_hex}${address_lo_hex}${length_hi_hex}${length_lo_hex}42533933${payload}")
  set(${out} "${object_hex}" PARENT_SCOPE)
endfunction()

function(lynx_write_bll payload_hex path load_addr)
  lynx_build_bll_hex(object_hex "${payload_hex}" "${load_addr}")
  string(REGEX REPLACE "#[^\r\n]*" "" payload "${payload_hex}")
  string(REGEX REPLACE "[ \t\r\n]" "" payload "${payload}")
  string(LENGTH "${payload}" payload_hex_len)
  math(EXPR payload_len "${payload_hex_len} / 2")
  math(EXPR address "${load_addr}")
  math(EXPR address_space_remaining "65536 - ${address}")
  if(payload_len GREATER address_space_remaining)
    message(FATAL_ERROR "BLL helper: payload crosses the 64 KiB boundary")
  endif()
  lynx_write_binary_hex("${object_hex}" "${path}")
endfunction()
